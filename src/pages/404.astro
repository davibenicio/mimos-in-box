---
import Base from '../layouts/Base.astro';
---
<Base titulo="Página não encontrada · Mimos in Box">
  <section class="sec" style="min-height:70svh;display:grid;place-items:center;text-align:center;padding-top:160px">
    <div class="cx" style="display:grid;gap:18px;justify-items:center">
      <h1 class="tit">Esse mimo <em>não está aqui</em></h1>
      <p class="sub">A página que você procura não existe. As cestas continuam no lugar.</p>
      <a class="bt" href="/">Voltar para o início</a>
    </div>
  </section>
</Base>
