---
// Monte a sua cesta: cesta de vime real em camadas, itens reais que caem dentro, total ao vivo e, no fim, a cesta sendo embrulhada.
import { ITENS, TAMANHOS, LACOS } from '../data/loja';
import { reais } from '../data/catalogo';
import medidas from '../data/medidas-itens.json';
import CestaReal from './CestaReal.astro';
const dados = { itens: ITENS.flatMap((g) => g.itens), tamanhos: TAMANHOS, lacos: LACOS, medidas };
---
<section class="sec mt pt-bolinhas" id="monte" data-montador>
  <div class="cx">
    <header class="mt-topo">
      <h2 class="tit" data-pal>Monte a <em>sua cesta</em></h2>
      <p class="sub" data-rev="sobe">Escolha o tamanho, a cor do laço e os itens. Cada um cai na cesta na hora, e no fim ela é embrulhada na sua frente.</p>
    </header>

    <div class="mt-g">
      <div class="mt-dir">
        <div class="mt-palco pt-coracoes">
          <span class="mt-base chip" hidden></span>
          <div class="mt-cena"><CestaReal /></div>
          <div class="mt-cont" aria-live="polite"><p><b class="gorda" data-n>0</b> de <span data-lim>10</span> itens</p><i><u data-barra></u></i></div>
        </div>
        <div class="mt-resumo">
          <div class="mt-tot"><span>Total estimado</span><b class="preco" data-vt>R$ 30,00</b></div>
          <button class="bt" type="button" data-embrulha disabled>Embrulhar e pedir</button>
          <p class="mt-nota">Itens <span data-vi>R$ 0,00</span> + embalagem <span data-ve>R$ 30,00</span>. Valores estimados: a loja confirma o total. <button class="mt-limpa" type="button" data-limpa hidden>Esvaziar a cesta</button></p>
        </div>
      </div>

      <form class="mt-ctl" onsubmit="return false">
        <fieldset class="mt-fs">
          <legend class="gorda">1. Tamanho</legend>
          <div class="mt-tams">
            {TAMANHOS.map((t) => (
              <label class="mt-tam">
                <input type="radio" name="tam" value={t.id} checked={t.id === 'M'} />
                <span><b class="gorda">{t.id}</b><strong>{t.nome}</strong><small>até {t.limite} itens</small><small>+ {reais(t.embalagem)} de embalagem</small></span>
              </label>
            ))}
          </div>
        </fieldset>
        <fieldset class="mt-fs">
          <legend class="gorda">2. Cor do laço</legend>
          <div class="mt-lacos">
            {LACOS.map((l, i) => (
              <label class="mt-lc" title={l.nome}>
                <input type="radio" name="laco" value={l.id} checked={i === 0} />
                <span style={`--c:${l.cor}`}><i class="so-leitor">{l.nome}</i></span>
              </label>
            ))}
          </div>
        </fieldset>
        <fieldset class="mt-fs">
          <legend class="gorda">3. Itens</legend>
          {ITENS.map((g, gi) => (
            <details class="mt-grp" open={gi < 2}>
              <summary><span>{g.grupo}</span><em data-gq></em></summary>
              <ul>
                {g.itens.map((it) => (
                  <li class="mt-it" data-item={it.id}>
                    <img src={`/img/m/${it.id}.webp`} alt="" width={(medidas as any)[it.id][0]} height={(medidas as any)[it.id][1]} loading="lazy" />
                    <span class="mt-in"><strong>{it.nome}</strong><small>{it.aPartir ? 'a partir de ' : ''}{reais(it.preco)}</small></span>
                    <span class="mt-st">
                      <button type="button" data-menos aria-label={`Tirar ${it.nome}`} disabled>−</button>
                      <output aria-label={`Quantidade de ${it.nome}`}>0</output>
                      <button type="button" data-mais aria-label={`Colocar ${it.nome}`}>+</button>
                    </span>
                  </li>
                ))}
              </ul>
            </details>
          ))}
        </fieldset>
      </form>
    </div>
  </div>
  <script type="application/json" id="mt-dados" set:html={JSON.stringify(dados)} />
</section>

<style is:global>
  .mt { background-color: var(--fundo); --pt: rgba(226, 69, 126, 0.11); }
  .mt-topo { display: grid; gap: 14px; margin-bottom: clamp(26px, 4vw, 46px); }
  .mt-g { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); gap: clamp(20px, 4vw, 56px); align-items: start; }
  .mt-ctl { grid-column: 1; grid-row: 1; display: grid; gap: 26px; }
  .mt-dir { grid-column: 2; grid-row: 1; position: sticky; top: 88px; display: grid; gap: 14px; }
  .mt-fs { border: 0; padding: 0; margin: 0; min-width: 0; }
  .mt-fs legend { font-size: 22px; color: var(--cereja); margin-bottom: 12px; padding: 0; }
  .mt-tams { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  .mt-tam input, .mt-lc input { position: absolute; opacity: 0; pointer-events: none; }
  .mt-tam span { display: grid; gap: 1px; height: 100%; padding: 12px 12px 14px; border-radius: 18px; background: var(--creme); border: 2px solid var(--pastel); cursor: pointer; transition: border-color 0.2s, box-shadow 0.2s, transform 0.4s var(--mola); }
  .mt-tam b { font-size: 30px; line-height: 1; color: var(--rosa-cl); transition: color 0.2s; }
  .mt-tam strong { font-size: 16px; } .mt-tam small { font-size: 13px; color: var(--tinta-suave); line-height: 1.25; }
  .mt-tam input:checked + span { border-color: var(--cereja); box-shadow: 0 5px 0 var(--cereja); transform: translateY(-3px); }
  .mt-tam input:checked + span b { color: var(--framboesa); }
  .mt-tam input:focus-visible + span, .mt-lc input:focus-visible + span { outline: 3px solid var(--framboesa); outline-offset: 3px; }
  .mt-lacos { display: flex; flex-wrap: wrap; gap: 10px; }
  .mt-lc span { display: block; width: 46px; height: 46px; border-radius: 50%; background: var(--c); border: 3px solid var(--creme); box-shadow: 0 0 0 2px var(--pastel); cursor: pointer; transition: transform 0.4s var(--mola), box-shadow 0.2s; }
  .mt-lc input:checked + span { transform: scale(1.14); box-shadow: 0 0 0 3px var(--cereja); }
  .mt-grp { border-radius: 18px; background: var(--creme); border: 2px solid var(--pastel); margin-bottom: 10px; overflow: hidden; }
  .mt-grp summary { display: flex; align-items: center; justify-content: space-between; gap: 10px; min-height: 54px; padding: 0 18px; font-weight: 800; font-size: 17px; cursor: pointer; list-style: none; color: var(--cereja); }
  .mt-grp summary::-webkit-details-marker { display: none; }
  .mt-grp summary::after { content: ''; width: 10px; height: 10px; border-right: 3px solid var(--cereja); border-bottom: 3px solid var(--cereja); rotate: 45deg; transition: rotate 0.3s var(--sai); margin-left: auto; }
  .mt-grp[open] summary::after { rotate: 225deg; }
  .mt-grp summary em { font-style: normal; font-size: 13px; background: var(--framboesa); color: #fff; padding: 2px 9px; border-radius: 99px; }
  .mt-grp summary em:empty { display: none; }
  .mt-it { display: grid; grid-template-columns: 54px minmax(0, 1fr) auto; align-items: center; gap: 12px; padding: 8px 12px 8px 14px; border-top: 2px dashed var(--pastel); transition: background-color 0.25s; }
  .mt-it.tem { background: var(--clarinho); }
  .mt-it img { width: 54px; height: 54px; object-fit: contain; transition: scale 0.4s var(--mola), rotate 0.4s var(--mola); }
  .mt-it:hover img { scale: 1.18; rotate: -6deg; }
  .mt-in { display: grid; line-height: 1.2; } .mt-in strong { font-size: 16px; } .mt-in small { font-size: 14px; color: var(--framboesa); font-weight: 800; }
  .mt-st { display: flex; align-items: center; gap: 4px; }
  .mt-st button { width: 44px; height: 44px; border-radius: 50%; border: 2px solid var(--cereja); background: var(--creme); color: var(--cereja); font-size: 24px; font-weight: 800; line-height: 1; display: grid; place-items: center; box-shadow: 0 3px 0 var(--cereja); transition: transform 0.12s; }
  .mt-st button[data-mais] { background: var(--rosa); color: #fff; }
  .mt-st button:active { transform: translateY(3px); box-shadow: none; }
  .mt-st button[disabled] { opacity: 0.35; box-shadow: none; cursor: not-allowed; }
  .mt-st output { min-width: 26px; text-align: center; font-family: var(--f-gorda); font-size: 19px; }
  .mt-st output.pula, [data-vt].pula, [data-n].pula { animation: mt-pula 0.45s var(--mola); }
  @keyframes mt-pula { 0% { scale: 1; } 35% { scale: 1.45; color: var(--rosa); } 100% { scale: 1; } }

  .mt-palco { position: relative; border-radius: 240px 240px 26px 26px; background-color: var(--cereja); border: 2px solid var(--cereja-esc); box-shadow: 0 7px 0 var(--cereja-esc); padding: 22px 24px 14px; overflow: hidden; }
  .mt-cena { width: min(100%, 390px, (100vh - 330px) / 1.3); margin-inline: auto; transition: scale 0.6s var(--mola); transform-origin: 50% 100%; }
  .mt[data-tam='P'] .mt-cena { scale: 0.86; } .mt[data-tam='M'] .mt-cena { scale: 0.94; }
  .mt-base { position: absolute; left: 50%; top: 14px; translate: -50% 0; z-index: 9; max-width: 80%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .mt-cont { margin-top: 8px; text-align: center; color: var(--pastel); font-weight: 700; display: grid; justify-items: center; gap: 6px; }
  .mt-cont b { font-size: 22px; color: #fff; display: inline-block; }
  .mt-cont i { display: block; width: min(240px, 80%); height: 8px; border-radius: 9px; background: var(--cereja-esc); overflow: hidden; }
  .mt-cont u { display: block; height: 100%; width: 0; border-radius: 9px; background: var(--rosa-cl); transition: width 0.5s var(--mola); }
  .mt-palco.cheia { animation: mt-treme 0.4s; }
  @keyframes mt-treme { 25% { translate: -6px 0; } 50% { translate: 6px 0; } 75% { translate: -3px 0; } }
  .mt-cora { position: absolute; z-index: 12; width: 22px; height: 22px; pointer-events: none; color: var(--rosa-cl); animation: mt-cora 1.1s var(--sai) forwards; }
  @keyframes mt-cora { from { opacity: 1; transform: translate(0, 0) scale(0.3) rotate(0deg); } to { opacity: 0; transform: translate(var(--dx), var(--dy)) scale(1.3) rotate(var(--dr)); } }

  .mt-resumo { background: var(--creme); border: 2px solid var(--cereja); border-radius: 22px; padding: 14px 16px; box-shadow: 0 6px 0 var(--cereja); display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 8px 14px; }
  .mt-tot { display: grid; line-height: 1.1; } .mt-tot span { font-weight: 700; font-size: 14.5px; }
  .mt-tot b { font-size: 30px; display: inline-block; justify-self: start; }
  .mt-nota { grid-column: 1 / -1; font-size: 13.5px; color: var(--tinta-suave); line-height: 1.4; }
  .mt-nota span { font-weight: 800; white-space: nowrap; }
  .mt-limpa { border: 0; background: none; padding: 0; color: var(--cereja); font-weight: 800; text-decoration: underline; }
  .mt.embrulhando .mt-ctl { pointer-events: none; opacity: 0.6; transition: opacity 0.3s; }

  @media (max-width: 900px) {
    .mt-g { display: flex; flex-direction: column; gap: 18px; }
    .mt-dir { display: contents; }
    .mt-palco { order: 1; position: sticky; top: 8px; z-index: 7; border-radius: 26px; padding: 12px 14px 10px; display: grid; grid-template-columns: 150px minmax(0, 1fr); align-items: center; gap: 10px; width: 100%; }
    .mt-cena { width: 150px; }
    .mt-cont { margin: 0; justify-items: start; text-align: left; }
    .mt-ctl { order: 2; width: 100%; }
    .mt-resumo { order: 3; position: sticky; bottom: 8px; z-index: 7; width: 100%; padding: 10px 12px 10px 16px; }
    .mt-tot b { font-size: 24px; } .mt-resumo .bt { padding: 0 18px; min-height: 48px; }
    .mt-nota { display: none; }
    .mt-tams { gap: 8px; } .mt-tam span { padding: 10px 8px 12px; } .mt-tam small { font-size: 12px; }
    .mt.embrulhando .mt-palco { grid-template-columns: minmax(0, 1fr); justify-items: center; } .mt.embrulhando .mt-cena { width: min(72%, 260px); } .mt.embrulhando .mt-cont { display: none; }
  }
</style>

<script>
  import { arruma, estilo, AUMENTO } from '../data/cesta';
  const sec = document.querySelector<HTMLElement>('[data-montador]')!;
  const D = JSON.parse(document.getElementById('mt-dados')!.textContent!);
  const MOLA = getComputedStyle(document.documentElement).getPropertyValue('--mola').trim();
  const calmo = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const cr = sec.querySelector<HTMLElement>('.cr')!, caixa = cr.querySelector<HTMLElement>('.cr-itens')!, palco = sec.querySelector<HTMLElement>('.mt-palco')!;
  const $ = (s: string) => sec.querySelector<HTMLElement>(s)!;
  const rs = (v: number) => 'R$ ' + v.toFixed(2).replace('.', ',');
  const est = { tam: 'M', laco: D.lacos[0].id as string, base: '' };
  let fichas: { id: string; el: HTMLImageElement }[] = [];
  const item = (id: string) => D.itens.find((i: any) => i.id === id);
  const tam = () => D.tamanhos.find((t: any) => t.id === est.tam);
  const anima = (el: Element, kf: Keyframe[], o: KeyframeAnimationOptions) => { if (calmo) return null; try { return el.animate(kf, o); } catch { return el.animate(kf, { ...o, easing: 'cubic-bezier(.3,1.5,.5,1)' }); } };

  const cria = (id: string) => { const [w, h] = D.medidas[id], im = new Image(w, h); im.src = `/img/m/${id}.webp`; im.alt = ''; im.className = 'cr-tk' + (id === 'balao' ? ' cr-tk--balao' : ''); return im; };
  /** Arruma todo mundo: altos atrás, baixos na frente. Quem já está na cesta desliza para o novo lugar. */
  const arrumaTudo = () => {
    const normais = fichas.filter((f) => f.id !== 'balao'), vs = arruma(normais.map((f) => item(f.id).alt));
    normais.forEach((f, i) => (f.el.style.cssText = estilo(vs[i])));
    fichas.filter((f) => f.id === 'balao').forEach((f, i) => (f.el.style.cssText = `left:${i % 2 ? 13 : 87}%;bottom:50%;height:${(item('balao').alt * AUMENTO * 100).toFixed(1)}cqw;z-index:0`));
  };
  const cai = (el: Element, atraso = 0) => anima(el, [{ transform: 'translateY(-150cqw) rotate(50deg)', opacity: 0 }, { opacity: 1, offset: 0.15 }, { transform: 'none', opacity: 1 }], { duration: 760, delay: atraso, easing: MOLA, fill: 'backwards' });
  const pula = (el: Element) => { el.classList.remove('pula'); void (el as HTMLElement).offsetWidth; el.classList.add('pula'); };
  const tira = (k: number) => { const f = fichas.splice(k, 1)[0]; const a = anima(f.el, [{ opacity: 1 }, { transform: 'translateY(-46cqw) scale(0.5) rotate(-30deg)', opacity: 0 }], { duration: 320, easing: 'ease-in' }); if (a) a.onfinish = () => f.el.remove(); else f.el.remove(); };

  const conta = () => {
    const t = tam(), n = fichas.length, soma = fichas.reduce((s, f) => s + item(f.id).preco, 0);
    sec.dataset.tam = est.tam; cr.style.setProperty('--laco', D.lacos.find((l: any) => l.id === est.laco).cor);
    $('[data-n]').textContent = String(n); $('[data-lim]').textContent = String(t.limite);
    $('[data-barra]').style.width = Math.min(100, (n / t.limite) * 100) + '%';
    $('[data-vi]').textContent = rs(soma); $('[data-ve]').textContent = rs(t.embalagem);
    const vt = $('[data-vt]'); const novo = rs(soma + t.embalagem); if (vt.textContent !== novo) { vt.textContent = novo; pula(vt); }
    ($('[data-embrulha]') as HTMLButtonElement).disabled = n === 0; $('[data-limpa]').hidden = n === 0;
    sec.querySelectorAll<HTMLElement>('[data-item]').forEach((li) => {
      const q = fichas.filter((f) => f.id === li.dataset.item).length, out = li.querySelector('output')!;
      if (out.textContent !== String(q)) { out.textContent = String(q); pula(out); }
      li.classList.toggle('tem', q > 0);
      (li.querySelector('[data-menos]') as HTMLButtonElement).disabled = q === 0;
      (li.querySelector('[data-mais]') as HTMLButtonElement).disabled = n >= t.limite;
    });
    sec.querySelectorAll<HTMLElement>('.mt-grp').forEach((g) => {
      const ids = new Set([...g.querySelectorAll<HTMLElement>('[data-item]')].map((li) => li.dataset.item));
      const q = fichas.filter((f) => ids.has(f.id)).length; g.querySelector('[data-gq]')!.textContent = q ? String(q) : '';
    });
  };
  const desembrulha = () => { cr.classList.remove('celo-on', 'laco-on'); sec.classList.remove('embrulhando', 'pronta'); };

  sec.addEventListener('click', (e) => {
    const alvo = e.target as HTMLElement, li = alvo.closest<HTMLElement>('[data-item]');
    if (li && alvo.closest('[data-mais]')) {
      if (fichas.length >= tam().limite) { palco.classList.remove('cheia'); void palco.offsetWidth; palco.classList.add('cheia'); return; }
      desembrulha(); const el = cria(li.dataset.item!); fichas.push({ id: li.dataset.item!, el }); arrumaTudo(); caixa.appendChild(el); cai(el); pula($('[data-n]')); conta();
    } else if (li && alvo.closest('[data-menos]')) {
      const k = fichas.map((f) => f.id).lastIndexOf(li.dataset.item!); if (k < 0) return;
      desembrulha(); tira(k); arrumaTudo(); conta();
    } else if (alvo.closest('[data-limpa]')) { desembrulha(); while (fichas.length) tira(fichas.length - 1); conta(); }
    else if (alvo.closest('[data-embrulha]')) embrulha();
  });
  sec.addEventListener('change', (e) => {
    const i = e.target as HTMLInputElement;
    if (i.name === 'laco') { est.laco = i.value; conta(); }
    if (i.name === 'tam') { est.tam = i.value; while (fichas.length > tam().limite) tira(fichas.length - 1); arrumaTudo(); conta(); }
  });

  /** O fim: a cesta é montada de novo item por item, o celofane sobe, o laço pousa, e o pedido abre. */
  const espera = (ms: number) => new Promise((r) => setTimeout(r, calmo ? 0 : ms));
  async function embrulha() {
    if (sec.classList.contains('embrulhando')) return;
    sec.classList.add('embrulhando'); cr.classList.remove('celo-on', 'laco-on');
    palco.scrollIntoView({ block: 'center', behavior: calmo ? 'auto' : 'smooth' });
    await espera(350);
    caixa.replaceChildren(); arrumaTudo();
    const fila = [...fichas].sort((a, b) => (+a.el.style.zIndex || 0) - (+b.el.style.zIndex || 0)), passo = Math.min(190, 1900 / fila.length);
    fila.forEach((f, k) => { caixa.appendChild(f.el); cai(f.el, k * passo); });
    await espera(fila.length * passo + 650);
    cr.classList.add('celo-on'); await espera(650);
    cr.classList.add('laco-on'); await espera(380);
    for (let i = 0; i < 14 && !calmo; i++) {
      const c = document.createElementNS('http://www.w3.org/2000/svg', 'svg'); c.setAttribute('viewBox', '0 0 24 24'); c.setAttribute('class', 'mt-cora');
      c.innerHTML = '<path fill="currentColor" d="M12 21C5 15.5 2 12.6 2 8.6A5.2 5.2 0 0 1 12 6.4 5.2 5.2 0 0 1 22 8.6c0 4-3 6.9-10 12.4z"/>';
      const a = (i / 14) * Math.PI * 2; c.style.cssText = `left:50%;top:22%;--dx:${Math.cos(a) * (90 + (i % 3) * 40)}px;--dy:${Math.sin(a) * (70 + (i % 4) * 30)}px;--dr:${(i % 2 ? 1 : -1) * 80}deg;color:${i % 2 ? 'var(--rosa-cl)' : 'var(--creme)'}`;
      palco.appendChild(c); setTimeout(() => c.remove(), 1200);
    }
    await espera(1100);
    sec.classList.add('pronta'); sec.classList.remove('embrulhando');
    const t = tam(), cont = new Map<string, number>(); fichas.forEach((f) => cont.set(f.id, (cont.get(f.id) ?? 0) + 1));
    const itens = [...cont].map(([id, q]) => `${q}× ${item(id).nome}`);
    const total = fichas.reduce((s, f) => s + item(f.id).preco, 0) + t.embalagem;
    window.dispatchEvent(new CustomEvent('mimos:pedido', { detail: { cena: cr.cloneNode(true), tipo: 'montada', nome: `Cesta montada, tamanho ${t.id} (${t.nome.toLowerCase()})`, itens, total, estimado: true, laco: D.lacos.find((l: any) => l.id === est.laco).nome, base: est.base, dias: 1, foto: '/img/m/cesta.webp' } }));
  }

  // "Personalizar esta" na ficha de um produto: traz a pessoa para cá com a cesta de origem anotada.
  addEventListener('mimos:personalizar', (e) => {
    est.base = (e as CustomEvent).detail.nome; const b = $('.mt-base'); b.textContent = 'Inspirada em: ' + est.base; b.hidden = false;
    sec.scrollIntoView({ behavior: calmo ? 'auto' : 'smooth' });
  });
  new IntersectionObserver(([e]) => document.documentElement.classList.toggle('no-monte', e.isIntersecting), { threshold: 0.05 }).observe(sec);
  conta();
</script>
