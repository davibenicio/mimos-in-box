---
import Fita from './Fita.astro';
// Sobre nós (ref. HUSH, 3ª dobra): texto à esquerda com a marca gigante e rosa embaixo, colagem à direita com duas
// cestas recortadas em arcos e uma fita de cetim na frente, cada peça numa profundidade da rolagem.
import { LOJA } from '../data/loja';
import { porNN } from '../data/catalogo';
const N1 = porNN('31'), N2 = porNN('09');
const FRASE = `Somos uma loja de cestas e presentes personalizados no ${LOJA.bairro}, em ${LOJA.cidade}. Montamos café da manhã, kits para aniversário e datas comemorativas, com a cor do laço e do balão que você escolher.`;
const VANTAGENS = [
  ['Cestas adulto e infantil', 'M4 10h16l-1.6 9H5.6zM8 10c0-3 1.6-5 4-5s4 2 4 5'],
  ['Kits para datas especiais', 'M4 7h16v13H4zM4 11h16M9 3v4M15 3v4M12 14.5l1 2 2.2.2-1.7 1.4.6 2.1-2.1-1.2-2.1 1.2.6-2.1L8.8 16.7l2.2-.2z'],
  ['Laço e balão à escolha', 'M12 12c-3-5-7-5-7-1s4 4 7 1zm0 0c3-5 7-5 7-1s-4 4-7 1zm0 0l-3 8m3-8l3 8'],
  ['Retirada ou entrega', 'M3 7h11v9H3zM14 10h4l3 3v3h-7zM7 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4zm10 0a2 2 0 1 0 0-4 2 2 0 0 0 0 4z'],
];
---
<section class="sec sb" id="loja">
  <Fita v={1} style="left:-70px;top:4%;width:clamp(180px,18vw,300px)" />
  <div class="cx sb-g">
    <div class="sb-txt">
      <h2 class="tit" data-pal>Feito com carinho, <em>do seu jeito.</em></h2>
      <p class="sb-ler" data-ler>{FRASE}</p>
      <ul class="sb-v">
        {VANTAGENS.map(([t, d], i) => (
          <li data-rev="sobe" style={`--i:${i}`}>
            <span class="sb-ic"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d={d} pathLength="1" /></svg></span>
            {t}
          </li>
        ))}
      </ul>
      <a class="bt" href="#cestas" data-rev="sobe" style="--i:4">Ver as cestas <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
    </div>
    <div class="sb-col">
      <figure class="sb-n sb-n1 flutua" data-rev="sobe" style="--fd2:4.7s">
        <i class="sb-arco"></i>
        <img src={N1.corte} alt={N1.nome} width={N1.cw} height={N1.ch} loading="lazy" data-abre={N1.nn} data-cur="ver" />
      </figure>
      <figure class="sb-n sb-n2 flutua" data-rev="sobe" style="--i:3">
        <i class="sb-arco"></i>
        <img src={N2.corte} alt={N2.nome} width={N2.cw} height={N2.ch} loading="lazy" data-abre={N2.nn} data-cur="ver" />
      </figure>
      <Fita v={4} class="sb-fita" />
      <span class="brilho sb-b" style="--t:30px" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 1.5c.6 5.6 4.9 9.9 10.5 10.5-5.6.6-9.9 4.9-10.5 10.5C11.4 16.9 7.1 12.6 1.5 12 7.1 11.4 11.4 7.1 12 1.5z" /></svg></span>
    </div>
  </div>
  <p class="gig gig-anda sb-gig" aria-hidden="true">Mimos in Box</p>
</section>

<style is:global>
  .sb { background: var(--papel); overflow: clip; padding-bottom: 0; }
  .sb-g { position: relative; z-index: 2; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr); gap: clamp(28px, 6vw, 90px); align-items: center; }
  .sb-txt { text-align: center; display: grid; justify-items: center; }
  .sb-ler { margin-top: 22px; font-size: clamp(18px, 1.8vw, 23px); line-height: 1.45; font-weight: 500; color: var(--tit); max-width: 34ch; }
  .sb-ler .lw { opacity: 0.22; transition: opacity 0.35s; }
  .sb-ler .lw.ac { opacity: 1; }
  .sb-v { margin: 30px 0 32px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px 18px; }
  .sb-v { text-align: left; }
  .sb-v li { display: flex; align-items: center; gap: 12px; font-weight: 700; line-height: 1.2; color: var(--tit); }
  .sb-ic { flex: none; width: 50px; height: 50px; border-radius: 50%; background: var(--pastel); color: var(--rosa); display: grid; place-items: center; transition: background-color 0.3s, color 0.3s; }
  .sb-v li:hover .sb-ic { background: var(--rosa); color: var(--creme); }
  .sb-col { position: relative; aspect-ratio: 1 / 1.05; max-width: 520px; width: 100%; justify-self: center; }
  .sb-n { position: absolute; margin: 0; translate: 0 var(--py, 0px); }
  .sb-arco { position: absolute; inset: 0; border-radius: 999px 999px 26px 26px; }
  .sb-n img { position: absolute; left: -4%; bottom: 5%; width: 108%; height: 84%; object-fit: contain; object-position: 50% 100%; filter: drop-shadow(0 20px 16px rgba(110, 40, 55, 0.3)); cursor: pointer; }
  .sb-n1 { left: 0; top: 0; width: 60%; aspect-ratio: 3 / 4; }
  .sb-n1 .sb-arco { background: radial-gradient(70% 50% at 50% 35%, var(--faixa-2), transparent 75%), var(--faixa); }
  .sb-n2 { right: 0; bottom: 0; width: 50%; aspect-ratio: 3 / 3.6; z-index: 2; }
  .sb-n2 .sb-arco { background: radial-gradient(70% 50% at 50% 35%, var(--creme), transparent 75%), var(--clarinho); box-shadow: 0 0 0 8px var(--papel), var(--sombra); }
  .sb-fita { width: 44%; right: 30%; top: 34%; z-index: 3; }
  .sb { position: relative; }
  .sb-b { right: 4%; top: 6%; }
  .sb-gig { position: relative; z-index: 1; margin: clamp(20px, 3vw, 40px) 0 -0.12em; font-size: clamp(92px, 16.5vw, 270px); translate: calc(-3% + var(--px, 0px)) 0; }
  @media (max-width: 860px) { .sb-g { grid-template-columns: minmax(0, 1fr); } .sb-col { max-width: 400px; order: -1; } }
  @media (max-width: 460px) { .sb-v { grid-template-columns: minmax(0, 1fr); } }
</style>
