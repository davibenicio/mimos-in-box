---
import { LOJA } from '../data/loja';
const FRASE = `Somos uma loja de cestas e presentes personalizados no ${LOJA.bairro}, em ${LOJA.cidade}. Montamos café da manhã, kits para aniversário e datas comemorativas, com a cor do laço e do balão que você escolher.`;
const VANTAGENS = [
  ['Cestas adulto e infantil', 'M4 10h16l-1.6 9H5.6zM8 10c0-3 1.6-5 4-5s4 2 4 5'],
  ['Kits para datas especiais', 'M4 7h16v13H4zM4 11h16M9 3v4M15 3v4M12 14.5l1 2 2.2.2-1.7 1.4.6 2.1-2.1-1.2-2.1 1.2.6-2.1L8.8 16.7l2.2-.2z'],
  ['Laço e balão à escolha', 'M12 12c-3-5-7-5-7-1s4 4 7 1zm0 0c3-5 7-5 7-1s-4 4-7 1zm0 0l-3 8m3-8l3 8'],
  ['Retirada ou entrega', 'M3 7h11v9H3zM14 10h4l3 3v3h-7zM7 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4zm10 0a2 2 0 1 0 0-4 2 2 0 0 0 0 4z'],
];
---
<section class="sec sb" id="loja">
  <div class="sb-vichy pt-vichy" aria-hidden="true"></div>
  <div class="cx sb-g">
    <div class="sb-fotos">
      <figure class="sb-f sb-f1" data-rev="pop"><img src="/img/p/19-1.webp" alt="Kit Coffee Premium em cesta preta com laço preto e dourado" width="900" height="1198" loading="lazy" /><i></i></figure>
      <figure class="sb-f sb-f2" data-rev="pop" style="--i:2"><img src="/img/p/35-1.webp" alt="Kit Maternidade Rosa com ursinho de pelúcia e manta" width="900" height="1198" loading="lazy" /><i></i></figure>
      <span class="sb-nota" data-rev="pop" style="--i:4">montada<br />do seu jeito</span>
    </div>
    <div class="sb-txt">
      <h2 class="tit" data-pal>A Mimos <em>in Box</em></h2>
      <p class="sb-ler" data-ler>{FRASE}</p>
      <ul class="sb-v">
        {VANTAGENS.map(([t, d], i) => (
          <li data-rev="sobe" style={`--i:${i}`}>
            <span class="sb-ic"><svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d={d} pathLength="1" /></svg></span>
            {t}
          </li>
        ))}
      </ul>
      <a class="bt" href="#cestas" data-rev="sobe" style="--i:4">Ver as cestas</a>
    </div>
  </div>
</section>

<style is:global>
  .sb { background: var(--creme); padding-top: clamp(100px, 12vw, 160px); }
  .sb-vichy { position: absolute; left: 0; top: 0; bottom: 0; width: min(38%, 520px); -webkit-mask: linear-gradient(90deg, #000 55%, #0000); mask: linear-gradient(90deg, #000 55%, #0000); }
  .sb-g { position: relative; display: grid; grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr); gap: clamp(28px, 6vw, 90px); align-items: center; }
  .sb-fotos { position: relative; aspect-ratio: 1 / 1.08; max-width: 520px; width: 100%; justify-self: center; }
  .sb-f { position: absolute; margin: 0; width: 60%; padding: 10px 10px 40px; background: #fff; box-shadow: 0 22px 40px -20px rgba(74, 19, 34, 0.6); }
  .sb-f img { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; }
  .sb-f i { position: absolute; left: 50%; top: -14px; width: 92px; height: 28px; margin-left: -46px; background: rgba(244, 122, 163, 0.75); rotate: -3deg; -webkit-mask: linear-gradient(90deg, #0000 0, #000 4px calc(100% - 4px), #0000); }
  .sb-f1 { left: 0; top: 0; rotate: -6deg; }
  .sb-f2 { right: 0; bottom: 0; rotate: 5deg; z-index: 2; }
  .sb-f:hover { z-index: 3; }
  .sb-f img { transition: scale 0.6s var(--sai); }
  .sb-f:hover img { scale: 1.04; }
  .sb-nota { position: absolute; right: 2%; top: 6%; z-index: 3; font-family: var(--f-script); font-size: clamp(20px, 2.4vw, 28px); line-height: 1.05; color: var(--framboesa); rotate: 8deg; text-align: center; }
  .sb-ler { margin-top: 22px; font-size: clamp(20px, 2.3vw, 30px); line-height: 1.32; font-weight: 700; color: var(--cereja); max-width: 26ch; }
  .sb-ler .lw { opacity: 0.22; transition: opacity 0.35s; }
  .sb-ler .lw.ac { opacity: 1; }
  .sb-v { margin: 30px 0 32px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px 18px; }
  .sb-v li { display: flex; align-items: center; gap: 12px; font-weight: 800; line-height: 1.2; }
  .sb-ic { flex: none; width: 56px; height: 56px; border-radius: 50%; background: var(--pastel); color: var(--cereja); display: grid; place-items: center; transition: rotate 0.5s var(--mola), background-color 0.2s; }
  .sb-v li:hover .sb-ic { rotate: -12deg; background: var(--rosa-cl); }
  html.js .sb-ic path { stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 1.3s 0.3s var(--sai); }
  html.js .visto .sb-ic path { stroke-dashoffset: 0; }
  @media (max-width: 860px) { .sb-g { grid-template-columns: minmax(0, 1fr); } .sb-fotos { max-width: 380px; } .sb-vichy { width: 100%; height: 420px; bottom: auto; -webkit-mask: linear-gradient(#000 40%, #0000); mask: linear-gradient(#000 40%, #0000); } }
  @media (max-width: 460px) { .sb-v { grid-template-columns: minmax(0, 1fr); } }
</style>
