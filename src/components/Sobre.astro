---
import { LOJA } from '../data/loja';
import { porNN } from '../data/catalogo';
// duas cestas sem fundo, cada uma no seu nicho: clara sobre bordô, escura sobre rosé
const N1 = porNN('29'), N2 = porNN('19');
const FRASE = `Somos uma loja de cestas e presentes personalizados no ${LOJA.bairro}, em ${LOJA.cidade}. Montamos café da manhã, kits para aniversário e datas comemorativas, com a cor do laço e do balão que você escolher.`;
const VANTAGENS = [
  ['Cestas adulto e infantil', 'M4 10h16l-1.6 9H5.6zM8 10c0-3 1.6-5 4-5s4 2 4 5'],
  ['Kits para datas especiais', 'M4 7h16v13H4zM4 11h16M9 3v4M15 3v4M12 14.5l1 2 2.2.2-1.7 1.4.6 2.1-2.1-1.2-2.1 1.2.6-2.1L8.8 16.7l2.2-.2z'],
  ['Laço e balão à escolha', 'M12 12c-3-5-7-5-7-1s4 4 7 1zm0 0c3-5 7-5 7-1s-4 4-7 1zm0 0l-3 8m3-8l3 8'],
  ['Retirada ou entrega', 'M3 7h11v9H3zM14 10h4l3 3v3h-7zM7 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4zm10 0a2 2 0 1 0 0-4 2 2 0 0 0 0 4z'],
];
---
<section class="sec sb" id="loja">
  <div class="sb-aneis aneis" aria-hidden="true"></div>
  <div class="cx sb-g">
    <div class="sb-fotos">
      <i class="sb-fio" aria-hidden="true"></i>
      <figure class="sb-n sb-n1" data-rev="sobe">
        <i class="sb-arco"></i>
        <img src={N1.corteG} srcset={`${N1.corte} 560w, ${N1.corteG} 800w`} sizes="(max-width: 860px) 60vw, 340px" alt={N1.nome} width={N1.gw} height={N1.gh} loading="lazy" data-abre={N1.nn} data-cur="ver" />
      </figure>
      <figure class="sb-n sb-n2" data-rev="sobe" style="--i:3">
        <i class="sb-arco"></i>
        <img src={N2.corte} alt={N2.nome} width={N2.cw} height={N2.ch} loading="lazy" data-abre={N2.nn} data-cur="ver" />
      </figure>
    </div>
    <div class="sb-txt">
      <h2 class="tit" data-pal>A Mimos <em>in Box</em></h2>
      <p class="sb-ler" data-ler>{FRASE}</p>
      <ul class="sb-v">
        {VANTAGENS.map(([t, d], i) => (
          <li data-rev="sobe" style={`--i:${i}`}>
            <span class="sb-ic"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d={d} pathLength="1" /></svg></span>
            {t}
          </li>
        ))}
      </ul>
      <a class="bt" href="#cestas" data-rev="sobe" style="--i:4">Ver as cestas</a>
    </div>
  </div>
</section>

<style is:global>
  .sb { background: radial-gradient(46% 44% at 0% 0%, rgba(239, 201, 207, 0.45), transparent 70%), var(--creme); padding-top: clamp(100px, 12vw, 160px); overflow: clip; }
  .sb-aneis { right: -260px; bottom: -300px; width: 760px; }
  .sb-g { position: relative; display: grid; grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr); gap: clamp(28px, 6vw, 90px); align-items: center; }
  /* dois nichos em arco (o mesmo do topo), com a cesta recortada na frente e um fio dourado deslocado */
  .sb-fotos { position: relative; aspect-ratio: 1 / 1.12; max-width: 500px; width: 100%; justify-self: center; }
  .sb-n { position: absolute; margin: 0; }
  .sb-arco { position: absolute; inset: 0; border-radius: 999px 999px 16px 16px; }
  .sb-n img { position: absolute; left: -5%; bottom: 5%; width: 110%; height: 86%; object-fit: contain; object-position: 50% 100%; filter: drop-shadow(0 20px 16px rgba(40, 0, 14, 0.4)); cursor: pointer; transition: translate 0.6s var(--sai); }
  .sb-n:hover img { translate: 0 -6px; }
  .sb-n1, .sb-fio { left: 0; top: 0; width: 68%; aspect-ratio: 3 / 4.1; }
  .sb-fio { position: absolute; margin: -14px 0 0 -14px; border: 1px solid var(--ouro); border-radius: 999px 999px 16px 16px; }
  .sb-n1 .sb-arco { background: radial-gradient(90% 55% at 32% 4%, rgba(251, 246, 240, 0.2), transparent 62%), var(--escama-clara), linear-gradient(180deg, var(--cereja), var(--cereja-esc)); }
  .sb-n1 .sb-arco::after { content: ''; position: absolute; inset: 11px; border-radius: 999px 999px 8px 8px; border: 1px solid rgba(216, 189, 140, 0.55); }
  .sb-n2 { right: 0; bottom: 0; width: 46%; aspect-ratio: 4 / 5.2; z-index: 2; }
  .sb-n2 .sb-arco { background: radial-gradient(80% 50% at 50% 30%, var(--campo), transparent 75%), linear-gradient(180deg, var(--pastel), var(--fundo)); box-shadow: 0 0 0 8px var(--creme), 0 0 0 9px var(--rosa-cl); }
  .sb-n2 img { height: 78%; bottom: 7%; }
  /* o arco sobe como cortina e a cesta chega logo depois */
  html.js .sb-n1 .sb-arco { clip-path: inset(100% 0 0 0); transition: clip-path 1.1s var(--sai); }
  html.js .sb-n1.visto .sb-arco { clip-path: inset(0 0 0 0); }
  html.js .sb-n img { opacity: 0; transform: translateY(30px); transition: opacity 0.6s 0.35s, transform 0.9s 0.35s var(--sai), translate 0.6s var(--sai); }
  html.js .sb-n.visto img { opacity: 1; transform: none; }
  html.js .sb-n[data-rev] { opacity: 1; transform: none; }
  html.js .sb-n2 .sb-arco { opacity: 0; transition: opacity 0.8s 0.2s; }
  html.js .sb-n2.visto .sb-arco { opacity: 1; }
  .sb-ler { margin-top: 22px; font-size: clamp(20px, 2.3vw, 30px); line-height: 1.32; font-weight: 700; color: var(--cereja); max-width: 26ch; }
  .sb-ler .lw { opacity: 0.22; transition: opacity 0.35s; }
  .sb-ler .lw.ac { opacity: 1; }
  .sb-v { margin: 30px 0 32px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px 18px; }
  .sb-v li { display: flex; align-items: center; gap: 12px; font-weight: 800; line-height: 1.2; }
  .sb-ic { flex: none; width: 52px; height: 52px; border-radius: 50%; border: 1px solid var(--rosa-cl); background: var(--clarinho); color: var(--cereja); display: grid; place-items: center; transition: background-color 0.3s, color 0.3s, border-color 0.3s; }
  .sb-v li:hover .sb-ic { background: var(--cereja); border-color: var(--cereja); color: var(--creme); }
  html.js .sb-ic path { stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 1.3s 0.3s var(--sai); }
  html.js .visto .sb-ic path { stroke-dashoffset: 0; }
  @media (max-width: 860px) { .sb-g { grid-template-columns: minmax(0, 1fr); } .sb-fotos { max-width: 360px; margin-left: 14px; width: calc(100% - 14px); } .sb-aneis { width: 520px; right: -220px; bottom: -220px; } }
  @media (max-width: 460px) { .sb-v { grid-template-columns: minmax(0, 1fr); } }
</style>
