---
import Fita from './Fita.astro';
// Faixa rosa "Em promoção" (ref. HUSH "New arrivals"): cápsulas de vidro com a cesta saindo por cima, em carrossel.
// A do meio fica na frente; as vizinhas atrás, menores e desfocadas. Troca sozinha com barra de tempo e pausa visível;
// setas coladas, toque e arraste trocam (RP-43). Só cestas com preço "de/por" no catálogo (dado real).
import { PRODUTOS, reais } from '../data/catalogo';
const itens = PRODUTOS.filter((p) => p.de).map((p) => ({ ...p, off: Math.round(((p.de! - p.preco) / p.de!) * 100) }));
---
<section class="po" id="promocoes" data-po aria-roledescription="carrossel" aria-labelledby="po-t">
  <Fita v={4} style="right:-30px;top:-40px;width:clamp(150px,14vw,240px);z-index:3" />
  <Fita v={1} style="left:-40px;bottom:-60px;width:clamp(150px,14vw,240px);z-index:3" />
  <div class="po-faixa">
    <Fita v={3} style="left:-80px;top:10px;width:clamp(300px,34vw,520px);opacity:.55" />
    <span class="brilho" style="--t:30px;right:8%;top:14%;color:#fff6ef" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 1.5c.6 5.6 4.9 9.9 10.5 10.5-5.6.6-9.9 4.9-10.5 10.5C11.4 16.9 7.1 12.6 1.5 12 7.1 11.4 11.4 7.1 12 1.5z" /></svg></span>
    <span class="brilho" style="--t:22px;left:9%;bottom:16%;color:#fff6ef;--d:6s" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 1.5c.6 5.6 4.9 9.9 10.5 10.5-5.6.6-9.9 4.9-10.5 10.5C11.4 16.9 7.1 12.6 1.5 12 7.1 11.4 11.4 7.1 12 1.5z" /></svg></span>
    <header class="po-topo">
      <span class="po-lado" aria-hidden="true">de / por</span>
      <h2 id="po-t" class="po-t">Em promoção</h2>
      <span class="po-lado" aria-hidden="true">pronta entrega</span>
    </header>
    <div class="po-pista" data-pista>
      {itens.map((p, i) => (
        <article class="po-c" data-c={i} aria-roledescription="slide" aria-label={`${i + 1} de ${itens.length}: ${p.nome}`}>
          <div class="po-cap vidro">
            <span class="po-off">−{p.off}%</span>
            <img src={p.corte} width={p.cw} height={p.ch} alt={p.nome} loading="lazy" decoding="async" draggable="false" />
          </div>
          <div class="po-inf">
            <h3>{p.nome}</h3>
            <p><s class="preco-de">{reais(p.de!)}</s> <b class="preco">{reais(p.preco)}</b></p>
            <button type="button" class="po-ver" data-abre={p.nn}>Ver cesta</button>
          </div>
        </article>
      ))}
      <button class="po-seta po-ant" type="button" data-ant aria-label="Cesta anterior"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg></button>
      <button class="po-seta po-prox" type="button" data-prox aria-label="Próxima cesta"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg></button>
    </div>
    <div class="po-ctl">
      <span class="po-tempo" aria-hidden="true"><i data-tempo></i></span>
      <button class="po-pausa" type="button" data-pausa aria-pressed="false">Pausar</button>
    </div>
  </div>
</section>

<style is:global>
  .po { position: relative; z-index: 2; background: var(--papel); padding: clamp(40px, 6vw, 80px) clamp(10px, 1.6vw, 22px); }
  .po-faixa { position: relative; overflow: hidden; border-radius: clamp(26px, 3vw, 40px); background: radial-gradient(70% 60% at 50% 0%, var(--faixa-2), transparent 70%), var(--faixa); padding: clamp(40px, 5vw, 64px) 0 30px; }
  .po-topo { position: relative; display: flex; justify-content: center; align-items: baseline; gap: clamp(18px, 5vw, 70px); padding-inline: 20px; }
  .po-t { font-family: var(--f-gigante); font-weight: 400; font-size: clamp(44px, 6.4vw, 92px); line-height: 0.9; text-transform: uppercase; color: var(--fixo-claro); letter-spacing: 0.01em; }
  html.ve .po-t { color: #f5b3c1; }
  .po-lado { font-weight: 700; font-size: 15px; color: color-mix(in srgb, var(--fixo-claro) 75%, transparent); white-space: nowrap; }
  .po-pista { position: relative; height: clamp(420px, 40vw, 520px); margin-top: clamp(24px, 3vw, 40px); touch-action: pan-y; user-select: none; }
  .po-c { position: absolute; left: 50%; top: 0; width: clamp(210px, 21vw, 280px); margin-left: calc(clamp(210px, 21vw, 280px) / -2); display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; justify-items: center; transition: transform 0.8s var(--sai), opacity 0.6s, filter 0.6s; will-change: transform; }
  .po-cap { position: relative; width: 100%; min-width: 0; aspect-ratio: 0.86; border-radius: 44px; overflow: visible; background: color-mix(in srgb, var(--fixo-claro) 28%, transparent); }
  .po-cap img { position: absolute; left: -6%; bottom: 6%; width: 112%; max-width: none; height: 100%; object-fit: contain; object-position: 50% 100%; filter: drop-shadow(0 18px 16px rgba(110, 40, 55, 0.3)); pointer-events: none; transition: translate 0.6s var(--sai); }
  .po-c.atual .po-cap img { animation: po-paira 5s ease-in-out infinite; }
  @keyframes po-paira { 50% { translate: 0 -8px; } }
  .po-off { position: absolute; left: 14px; top: 14px; z-index: 2; padding: 5px 11px; border-radius: 99px; font-weight: 800; font-size: 13px; color: var(--fixo-escuro); background: color-mix(in srgb, var(--fixo-claro) 80%, transparent); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); }
  .po-inf { display: grid; gap: 6px; justify-items: center; text-align: center; }
  .po-inf h3 { font-family: var(--f-serif); font-weight: 600; font-size: 19px; line-height: 1.15; color: var(--fixo-escuro); max-width: 16ch; }
  html.ve .po-inf h3 { color: #f8e7dc; }
  .po-inf p { display: flex; align-items: baseline; gap: 8px; font-size: 20px; }
  .po .preco { color: var(--fixo-escuro); } .po .preco-de { color: color-mix(in srgb, var(--fixo-escuro) 65%, transparent); }
  html.ve .po .preco { color: #fff; } html.ve .po .preco-de { color: #e9c3cc; }
  .po-ver { min-height: 40px; padding: 0 18px; border: 0; border-radius: 99px; font-weight: 700; font-size: 14px; color: var(--fixo-escuro); background: var(--fixo-claro); transition: transform 0.3s var(--sai); }
  .po-ver:hover { transform: translateY(-2px); }
  .po-c:not(.atual) { cursor: pointer; }
  .po-c:not(.atual) .po-ver { visibility: hidden; }
  .po-seta { position: absolute; top: 34%; z-index: 20; width: 52px; height: 52px; border: 0; border-radius: 50%; display: grid; place-items: center; color: var(--fixo-escuro); background: color-mix(in srgb, var(--fixo-claro) 55%, transparent); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.6); transition: transform 0.3s var(--sai), background-color 0.2s; }
  .po-seta:hover { transform: scale(1.08); background: var(--fixo-claro); }
  .po-seta svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .po-ant { left: max(14px, 50% - 470px); } .po-prox { right: max(14px, 50% - 470px); }
  .po-ctl { display: flex; justify-content: center; align-items: center; gap: 14px; margin-top: 6px; }
  .po-tempo { width: 120px; height: 3px; border-radius: 3px; background: rgba(255, 255, 255, 0.4); overflow: hidden; }
  .po-tempo i { display: block; height: 100%; background: var(--fixo-claro); transform-origin: left; transform: scaleX(var(--t, 0)); }
  .po-pausa { min-height: 40px; padding: 0 16px; border: 0; border-radius: 99px; font-weight: 700; font-size: 13.5px; color: var(--fixo-escuro); background: color-mix(in srgb, var(--fixo-claro) 60%, transparent); }
  @media (max-width: 700px) {
    .po-lado { display: none; }
    .po-pista { height: 430px; }
    .po-seta { top: 30%; width: 44px; height: 44px; }
  }
  @media (prefers-reduced-motion: reduce) { .po-c { transition: opacity 0.3s; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-po]').forEach((sec) => {
    const cs = [...sec.querySelectorAll<HTMLElement>('[data-c]')];
    const pausa = sec.querySelector<HTMLButtonElement>('[data-pausa]')!, tempo = sec.querySelector<HTMLElement>('[data-tempo]')!;
    const n = cs.length, DUR = 4800, calmo = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let i = 0, gasto = 0, t0 = performance.now(), parado = calmo, segura = false, visivel = false;
    const pinta = () => {
      const cel = innerWidth < 700, w = cs[0].offsetWidth, passo = cel ? Math.min(innerWidth * 0.58, w * 1.06) : w * 1.12;
      cs.forEach((c, k) => {
        let d = k - i; if (d > n / 2) d -= n; if (d < -n / 2) d += n;
        const a = Math.abs(d), vis = a <= (cel ? 1 : 2);
        c.classList.toggle('atual', d === 0);
        c.style.transform = `translateX(${d * passo}px) translateY(${a * 26}px) scale(${1 - a * 0.16})`;
        c.style.opacity = vis ? String(1 - a * 0.25) : '0';
        c.style.filter = a ? `blur(${a * 2}px) saturate(${1 - a * 0.25})` : 'none';
        c.style.zIndex = String(10 - a);
        c.style.pointerEvents = vis ? '' : 'none';
        c.toggleAttribute('inert', d !== 0); c.setAttribute('aria-hidden', String(d !== 0));
      });
    };
    const vai = (k: number) => { i = (k + n) % n; gasto = 0; pinta(); };
    const segurar = () => { segura = true; clearTimeout((segurar as any).t); (segurar as any).t = setTimeout(() => (segura = false), 7000); };
    sec.querySelector('[data-prox]')!.addEventListener('click', () => { vai(i + 1); segurar(); });
    sec.querySelector('[data-ant]')!.addEventListener('click', () => { vai(i - 1); segurar(); });
    cs.forEach((c, k) => c.addEventListener('click', () => { if (k !== i) { vai(k); segurar(); } }));
    pausa.addEventListener('click', () => { parado = !parado; pausa.setAttribute('aria-pressed', String(parado)); pausa.textContent = parado ? 'Continuar' : 'Pausar'; });
    if (calmo) { pausa.setAttribute('aria-pressed', 'true'); pausa.textContent = 'Continuar'; }
    sec.addEventListener('pointerenter', (e) => { if ((e as PointerEvent).pointerType === 'mouse') segura = true; });
    sec.addEventListener('pointerleave', (e) => { if ((e as PointerEvent).pointerType === 'mouse') segura = false; });
    sec.addEventListener('focusin', () => (segura = true)); sec.addEventListener('focusout', () => (segura = false));
    const pista = sec.querySelector<HTMLElement>('[data-pista]')!;
    let x0 = 0, y0 = 0, arr = false;
    pista.addEventListener('pointerdown', (e) => { x0 = e.clientX; y0 = e.clientY; arr = true; });
    addEventListener('pointerup', (e) => { if (!arr) return; arr = false; const dx = e.clientX - x0, dy = e.clientY - y0; if (Math.abs(dx) > 44 && Math.abs(dx) > Math.abs(dy) * 1.3) { vai(i + (dx < 0 ? 1 : -1)); segurar(); } });
    new IntersectionObserver(([e]) => (visivel = e.isIntersecting), { threshold: 0.3 }).observe(sec);
    const tick = (t: number) => { if (visivel && !parado && !segura) { gasto += t - t0; if (gasto >= DUR) vai(i + 1); } t0 = t; tempo.style.setProperty('--t', String(Math.min(1, gasto / DUR))); requestAnimationFrame(tick); };
    addEventListener('resize', pinta); pinta(); requestAnimationFrame(tick);
  });
</script>
