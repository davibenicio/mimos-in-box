---
import { LOJA, CATEGORIAS } from '../data/loja';
const ano = new Date().getFullYear();
---
<footer class="rd pt-coracoes renda-t">
  <div class="cx rd-g">
    <div class="rd-m">
      <img src="/img/logo-192.webp" alt="Mimos in Box" width="96" height="96" loading="lazy" />
      <p>{LOJA.assinatura} em {LOJA.cidade}, {LOJA.uf}.</p>
    </div>
    <nav aria-label="Rodapé"><h2>Navegar</h2><a href="#loja">A loja</a><a href="#cardapio">Cardápio</a><a href="#cestas">Cestas</a><a href="#monte">Monte a sua</a><a href="#contato">Contato</a></nav>
    <nav aria-label="Categorias"><h2>Categorias</h2>{CATEGORIAS.map((c) => <a href="#cestas" data-filtro={c.id}>{c.nome}</a>)}<a href="#cestas" data-filtro="promo">Promoções</a></nav>
    <div><h2>Onde estamos</h2><p>{LOJA.endereco}, {LOJA.bairro}<br />{LOJA.referencia}<br />{LOJA.cidade}, {LOJA.uf}</p><p><a href={LOJA.whatsappLink} target="_blank" rel="noopener">{LOJA.whatsappTexto}</a></p></div>
    <div><h2>Pagamento</h2><ul class="rd-pg">{LOJA.pagamentos.map((p) => <li>{p}</li>)}</ul></div>
  </div>
  <div class="rd-marca" aria-hidden="true" data-letras>{[...'Mimos in Box'].map((l, i) => <span style={`--i:${i}`}>{l === ' ' ? ' ' : l}</span>)}</div>
  <div class="cx rd-fim"><span>© {ano} {LOJA.nome}</span><button type="button" class="rd-pausa" data-pausa-geral aria-pressed="false">Pausar animações</button></div>
</footer>

<style is:global>
  .rd { position: relative; background-color: var(--cereja-esc); color: var(--pastel); padding-top: clamp(60px, 8vw, 100px); overflow: clip; }
  .rd-g { display: grid; grid-template-columns: 1.3fr 1fr 1fr 1.3fr 1fr; gap: 30px; }
  .rd-m img { width: 92px; height: 92px; border-radius: 50%; box-shadow: 0 0 0 3px var(--creme); }
  .rd-m p { margin-top: 14px; max-width: 24ch; font-weight: 700; color: var(--creme); }
  .rd h2 { font-family: var(--f-gorda); font-weight: 400; font-size: 18px; color: var(--creme); margin-bottom: 10px; }
  .rd nav { display: grid; align-content: start; justify-items: start; }
  .rd a { color: inherit; text-decoration: none; padding: 5px 0; min-height: 34px; font-weight: 700; background: linear-gradient(currentColor 0 0) 0 86% / 0 2px no-repeat; transition: background-size 0.4s var(--sai), color 0.2s; }
  .rd a:hover { color: #fff; background-size: 100% 2px; }
  .rd p { font-size: 15.5px; line-height: 1.5; }
  .rd-pg { display: flex; flex-wrap: wrap; gap: 8px; }
  .rd-pg li { font-size: 13.5px; font-weight: 800; padding: 5px 12px; border-radius: 99px; border: 2px solid var(--pastel); }
  .rd-marca { margin-top: clamp(30px, 5vw, 60px); font-family: var(--f-script); font-size: clamp(64px, 17.5vw, 290px); line-height: 0.92; text-align: center; color: var(--rosa); white-space: nowrap; }
  .rd-marca span { display: inline-block; }
  html.js .rd-marca span { transform: translateY(70%) rotate(8deg); opacity: 0; filter: blur(10px); transition: transform 1s var(--mola), opacity 0.6s, filter 0.6s; transition-delay: calc(var(--i) * 55ms); }
  html.js .rd-marca.visto span { transform: none; opacity: 1; filter: none; }
  .rd-fim { padding-right: 190px; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; padding-block: 18px 26px; font-size: 14px; border-top: 2px dashed rgba(246, 193, 214, 0.3); margin-top: 10px; }
  .rd-pausa { min-height: 44px; padding: 0 16px; border-radius: 99px; border: 2px solid var(--pastel); background: none; color: var(--pastel); font-weight: 800; font-size: 14px; }
  .rd-pausa[aria-pressed='true'] { background: var(--pastel); color: var(--cereja-esc); }
  @media (max-width: 700px) { .rd-fim { padding-right: 76px; } }
  @media (max-width: 900px) { .rd-g { grid-template-columns: repeat(2, minmax(0, 1fr)); } .rd-m { grid-column: 1 / -1; } }
</style>
