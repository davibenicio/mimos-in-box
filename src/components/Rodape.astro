---
import Fita from './Fita.astro';
import { LOJA, CATEGORIAS } from '../data/loja';
const ano = new Date().getFullYear();
---
<footer class="rd renda-t">
  <Fita v={3} style="right:-80px;top:30px;width:clamp(280px,30vw,480px);opacity:.35" />
  <span class="brilho" style="--t:30px;left:8%;top:40px;color:#f5b3c1" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 1.5c.6 5.6 4.9 9.9 10.5 10.5-5.6.6-9.9 4.9-10.5 10.5C11.4 16.9 7.1 12.6 1.5 12 7.1 11.4 11.4 7.1 12 1.5z" /></svg></span>
  <div class="cx rd-g">
    <div class="rd-m">
      <img src="/img/logo-192.webp" alt="Mimos in Box" width="96" height="96" loading="lazy" />
      <p>{LOJA.assinatura} em {LOJA.cidade}, {LOJA.uf}.</p>
    </div>
    <nav aria-label="Rodapé"><h2>Navegar</h2><a href="#loja">A loja</a><a href="#cestas">Cestas</a><a href="#monte">Monte a sua</a><a href="#como-pedir">Como pedir</a><a href="#contato">Contato</a></nav>
    <nav aria-label="Categorias"><h2>Categorias</h2>{CATEGORIAS.map((c) => <a href="#cestas" data-filtro={c.id}>{c.nome}</a>)}<a href="#cestas" data-filtro="promo">Promoções</a></nav>
    <div><h2>Onde estamos</h2><p>{LOJA.endereco}, {LOJA.bairro}<br />{LOJA.referencia}<br />{LOJA.cidade}, {LOJA.uf}</p><p><a href={LOJA.whatsappLink} target="_blank" rel="noopener">{LOJA.whatsappTexto}</a></p></div>
    <div><h2>Pagamento</h2><ul class="rd-pg">{LOJA.pagamentos.map((p) => <li>{p}</li>)}</ul></div>
  </div>
  <div class="rd-marca" aria-hidden="true" data-letras>{[...'Mimos in Box'].map((l, i) => <span style={`--i:${i}`}>{l === ' ' ? ' ' : l}</span>)}</div>
  <div class="cx rd-fim"><span>© {ano} {LOJA.nome}</span><button type="button" class="rd-pausa" data-pausa-geral aria-pressed="false">Pausar animações</button></div>
</footer>

<style is:global>
  .rd { position: relative; background-color: #3a1d24; color: #f3cdd5; padding-top: clamp(60px, 8vw, 100px); overflow-x: clip; }
  .rd-g { display: grid; grid-template-columns: 1.3fr 1fr 1fr 1.3fr 1fr; gap: 30px; }
  .rd-m img { width: 92px; height: 92px; border-radius: 50%; background: #fffaf4; box-shadow: 0 0 0 3px #fffaf4; }
  .rd-m p { margin-top: 14px; max-width: 24ch; font-weight: 700; color: #fffaf4; }
  .rd h2 { font-family: var(--f-serif); font-weight: 600; font-size: 19px; color: #fffaf4; margin-bottom: 10px; }
  .rd nav { display: grid; align-content: start; justify-items: start; }
  .rd a { color: inherit; text-decoration: none; padding: 5px 0; min-height: 34px; font-weight: 700; background: linear-gradient(currentColor 0 0) 0 86% / 0 2px no-repeat; transition: background-size 0.4s var(--sai), color 0.2s; }
  .rd a:hover { color: #fffaf4; background-size: 100% 2px; }
  .rd p { font-size: 15.5px; line-height: 1.5; }
  .rd-pg { display: flex; flex-wrap: wrap; gap: 8px; }
  .rd-pg li { font-size: 13.5px; font-weight: 800; padding: 5px 12px; border-radius: 99px; border: 1px solid rgba(239, 201, 207, 0.6); }
  .rd-marca { margin-top: clamp(30px, 5vw, 60px); font-family: var(--f-gigante); text-transform: uppercase; font-size: clamp(64px, 15.4vw, 250px); line-height: 0.86; text-align: center; color: #f5b3c1; white-space: nowrap; }
  .rd-marca span { display: inline-block; }
  .rd-marca span { animation: rd-onda 4s calc(var(--i) * -0.3s) ease-in-out infinite alternate; }
  @keyframes rd-onda { from { transform: translateY(-4%); } to { transform: translateY(4%); } }
  .rd-fim { padding-right: 190px; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; padding-block: 18px 26px; font-size: 14px; border-top: 1px solid rgba(239, 201, 207, 0.25); margin-top: 10px; }
  .rd-pausa { min-height: 44px; padding: 0 16px; border-radius: 99px; border: 1px solid #f3cdd5; background: none; color: #f3cdd5; font-weight: 800; font-size: 14px; }
  .rd-pausa[aria-pressed='true'] { background: #f3cdd5; color: #3a1d24; }
  @media (max-width: 700px) { .rd-fim { padding-right: 76px; } }
  @media (max-width: 900px) { .rd-g { grid-template-columns: repeat(2, minmax(0, 1fr)); } .rd-m { grid-column: 1 / -1; } }
</style>
