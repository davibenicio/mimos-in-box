---
import { LOJA } from '../data/loja';
---
<div class="prog" aria-hidden="true"></div>
<a class="wa" href={LOJA.whatsappLink} target="_blank" rel="noopener" aria-label="Tirar dúvidas no WhatsApp">
  <svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true"><path fill="currentColor" d="M16 3a13 13 0 0 0-11.2 19.6L3 29l6.6-1.7A13 13 0 1 0 16 3zm0 2.4a10.6 10.6 0 1 1-5.4 19.7l-.4-.2-3.9 1 1-3.8-.2-.4A10.6 10.6 0 0 1 16 5.400zm-4.500 5.200c-.3 0-.7.100-1 .500-.4.400-1.400 1.300-1.400 3.200s1.400 3.700 1.600 4c.2.300 2.700 4.300 6.700 5.800 3.300 1.300 4 1 4.700.9.700-.1 2.300-.900 2.600-1.800.3-.900.300-1.700.200-1.800-.1-.200-.4-.300-.800-.500l-2.600-1.300c-.4-.100-.600-.200-.900.200l-1.200 1.500c-.200.300-.400.300-.800.100-.4-.200-1.600-.600-3-1.900-1.100-1-1.900-2.200-2.100-2.600-.2-.400 0-.600.200-.800l.6-.700c.2-.200.300-.400.400-.600.100-.300.100-.500 0-.700l-1.200-2.900c-.300-.700-.600-.600-.900-.600z"/></svg>
  <span>Tirar dúvidas</span>
</a>

<style is:global>
  /* fita de progresso da página (só onde o navegador liga animação à rolagem) */
  .prog { display: none; }
  @supports (animation-timeline: scroll()) {
    .prog { display: block; position: fixed; left: 0; right: 0; top: 0; height: 5px; z-index: 70; transform-origin: 0 50%; background: repeating-linear-gradient(90deg, var(--framboesa) 0 14px, var(--rosa-cl) 14px 28px); animation: prog-cresce linear both; animation-timeline: scroll(root); }
    @keyframes prog-cresce { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  }
  .wa { position: fixed; right: max(16px, env(safe-area-inset-right)); bottom: max(16px, env(safe-area-inset-bottom)); z-index: 50; display: flex; align-items: center; gap: 10px; height: 58px; padding: 0 22px 0 14px; border-radius: 99px; background: var(--wa); color: #fff; font-weight: 800; text-decoration: none; border: 2px solid #0b5c31; box-shadow: 0 5px 0 #0b5c31; transition: transform 0.5s var(--mola), opacity 0.3s; }
  .wa::before { content: ''; position: absolute; inset: -2px; border-radius: inherit; border: 2px solid var(--wa); animation: wa-pulso 2.6s ease-out infinite; pointer-events: none; }
  @keyframes wa-pulso { from { opacity: 0.8; transform: scale(1); } to { opacity: 0; transform: scale(1.25, 1.6); } }
  .wa:hover { transform: translateY(-3px) rotate(-2deg); }
  .wa:active { transform: translateY(4px); box-shadow: none; }
  html.modal .wa { opacity: 0; pointer-events: none; }
  @media (max-width: 700px) {
    .wa { width: 58px; padding: 0; justify-content: center; } .wa span { display: none; }
    html.no-hero .wa, html.no-monte .wa, html.no-cardapio .wa { transform: translateY(120px); }
  }
</style>

<script>
  const bp = document.querySelector<HTMLButtonElement>('[data-pausa-geral]');
  bp?.addEventListener('click', () => { const on = document.documentElement.classList.toggle('pausado'); bp.setAttribute('aria-pressed', String(on)); bp.textContent = on ? 'Retomar animações' : 'Pausar animações'; });
</script>
