---
// Ficha da cesta (abre de qualquer botão com data-abre="NN").
import { PRODUTOS } from '../data/catalogo';
import { CATEGORIAS, LOJA } from '../data/loja';
const NOMES = Object.fromEntries(CATEGORIAS.map((c) => [c.id, c.nome]));
const dados = PRODUTOS.map((p) => ({ nn: p.nn, id: p.id, nome: p.nome, cat: NOMES[p.categoria], preco: p.preco, de: p.de, desc: p.descricao, dias: p.dias, corte: p.corte, w: p.gw, h: p.gh }));
---
<dialog class="pr" id="ficha" aria-labelledby="pr-nome">
  <div class="pr-cx">
    <button class="dlg-x" type="button" data-fecha aria-label="Fechar"><svg viewBox="0 0 24 24" width="20" height="20"><path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="3" stroke-linecap="round" /></svg></button>
    <div class="pr-gal">
      <div class="pr-arco" aria-hidden="true"></div>
      <img class="pr-img" alt="" width="800" height="800" />
    </div>
    <div class="pr-inf">
      <p class="pr-etq"><span class="chip" data-cat></span><span class="selo-promo" data-promo hidden>Promoção</span></p>
      <h2 class="tit" id="pr-nome"></h2>
      <p class="pr-preco"><s class="preco-de" data-de></s><b class="preco" data-preco></b></p>
      <p class="pr-desc" data-desc></p>
      <ul class="pr-reg">
        <li data-prazo></li>
        <li>{LOJA.regras.laco}</li>
        <li>Retirada no {LOJA.bairro} ou entrega pela 99.</li>
      </ul>
      <div class="pr-bts">
        <button class="bt" type="button" data-comprar>Comprar esta cesta</button>
        <button class="bt bt--linha" type="button" data-personalizar>Personalizar esta</button>
      </div>
    </div>
  </div>
</dialog>
<script type="application/json" id="produtos" set:html={JSON.stringify(dados)} />

<style is:global>
  .pr { width: min(980px, 100% - 24px); max-height: calc(100dvh - 24px); margin: auto; overflow: visible; }
  .pr-cx { position: relative; display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); background: var(--creme); border-radius: 30px; box-shadow: var(--sombra-2); overflow: hidden; max-height: calc(100dvh - 24px); }
  /* a cesta sem fundo, num nicho: luz clara, anéis finos e o arco de veludo do topo */
  .pr-gal { position: relative; min-height: 460px; overflow: hidden; background: radial-gradient(70% 50% at 50% 40%, var(--faixa-2), transparent 74%), var(--faixa); }
  .pr-arco { position: absolute; left: 12%; right: 12%; bottom: 3%; height: 13%; border-radius: 50% / 46%; background: linear-gradient(180deg, var(--pedestal-1), var(--pedestal-2)); box-shadow: 0 20px 30px -20px rgba(110, 30, 50, 0.5); }
  .pr-arco::before { content: ''; position: absolute; inset: 0 0 50%; border-radius: 50%; background: radial-gradient(60% 70% at 50% 40%, var(--creme), var(--pedestal-1)); }
  .pr-img { position: absolute; left: 6%; bottom: 5%; width: 88%; height: 84%; object-fit: contain; object-position: 50% 100%; filter: drop-shadow(0 22px 16px rgba(40, 0, 14, 0.42)); }
  dialog[open] .pr-img { animation: pr-sobe 0.7s 0.12s var(--sai) both; }
  @keyframes pr-sobe { from { opacity: 0; transform: translateY(34px) scale(0.92); } }
  .pr-inf { padding: clamp(22px, 3.4vw, 40px); display: grid; gap: 12px; align-content: center; overflow-y: auto; }
  .pr-etq { display: flex; gap: 8px; align-items: center; }
  .pr-inf .tit { font-size: clamp(32px, 4vw, 50px); padding-right: 40px; }
  .pr-preco { display: flex; align-items: baseline; gap: 10px; font-size: 34px; }
  .pr-desc { font-size: 16.5px; }
  .pr-reg { display: grid; gap: 6px; padding: 12px 14px; border-radius: 16px; background: var(--clarinho); border: 1.5px dashed var(--rosa-cl); font-size: 15px; font-weight: 700; }
  .pr-reg li { display: flex; gap: 9px; align-items: baseline; }
  .pr-reg li::before { content: ''; flex: none; width: 9px; height: 9px; border-radius: 50%; background: var(--framboesa); }
  .pr-bts { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 6px; }
  @media (max-width: 760px) {
    .pr-cx { grid-template-columns: minmax(0, 1fr); overflow-y: auto; }
    .pr-gal { min-height: 250px; }
    .pr-arco { left: 24%; right: 24%; height: 76%; }
    .pr-img { height: 88%; }
    .pr-inf { overflow: visible; }
    .pr-bts .bt { width: 100%; }
  }
</style>

<script>
  const dlg = document.getElementById('ficha') as HTMLDialogElement;
  const P: any[] = JSON.parse(document.getElementById('produtos')!.textContent!);
  const $ = (s: string) => dlg.querySelector<HTMLElement>(s)!;
  const foto = dlg.querySelector<HTMLImageElement>('.pr-img')!;
  const rs = (v: number) => 'R$ ' + v.toFixed(2).replace('.', ',');
  let atual: any = null;
  const abre = (nn: string) => {
    const p = P.find((x) => x.nn === nn); if (!p) return; atual = p;
    $('[data-cat]').textContent = p.cat; $('[data-promo]').hidden = !p.de; $('#pr-nome').textContent = p.nome;
    $('[data-de]').textContent = p.de ? rs(p.de) : ''; $('[data-preco]').textContent = rs(p.preco); $('[data-desc]').textContent = p.desc;
    $('[data-prazo]').textContent = p.dias > 1 ? 'Peça com 48h de antecedência.' : 'Pode pedir em qualquer dia da semana.';
    // primeiro o recorte de 560 px (quase sempre já em cache pela lista), depois o de 800 px
    foto.alt = p.nome; foto.width = p.w; foto.height = p.h; foto.src = p.corte;
    const g = new Image(); g.onload = () => { if (atual === p) foto.src = g.src; }; g.src = `/img/c/${nn}-g.webp`;
    if (!dlg.open) dlg.showModal(); document.documentElement.classList.add('modal');
  };
  document.addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest<HTMLElement>('[data-abre]'); if (b) { e.preventDefault(); abre(b.dataset.abre!); } });
  dlg.addEventListener('click', (e) => { if (e.target === dlg || (e.target as HTMLElement).closest('[data-fecha]')) dlg.close(); });
  dlg.addEventListener('close', () => { if (!document.querySelector('dialog[open]')) document.documentElement.classList.remove('modal'); });
  $('[data-comprar]').addEventListener('click', () => { const p = atual; dlg.close(); window.dispatchEvent(new CustomEvent('mimos:pedido', { detail: { tipo: 'pronta', nome: p.nome, itens: [], total: p.preco, estimado: false, laco: '', base: '', dias: p.dias, foto: p.corte } })); });
  $('[data-personalizar]').addEventListener('click', () => { const p = atual; dlg.close(); window.dispatchEvent(new CustomEvent('mimos:personalizar', { detail: { nome: p.nome } })); });
</script>
