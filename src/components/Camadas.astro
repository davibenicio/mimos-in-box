---
import Fita from './Fita.astro';
// Faixa de camadas (RP-56): cada camada anda numa velocidade com a rolagem. Fundo: palavras gigantes em sentidos
// opostos. Meio: fitas de cetim e cestas recortadas em profundidades diferentes. Frente: a frase e o botão.
import { porNN } from '../data/catalogo';
import { LOJA } from '../data/loja';
const C = ['08', '31', '24'].map(porNN);
---
<section class="cm" aria-labelledby="cm-t" data-inverte>
  <div class="cm-pal" aria-hidden="true">
    <p class="gig gig-anda cm-r1">Café da manhã · Kits presente · Bebê · Café da manhã · Kits presente ·</p>
    <p class="gig gig-anda cm-r2">Feito com carinho · Feito com carinho · Feito com carinho ·</p>
  </div>
  <Fita v={1} class="cm-f1" />
  <Fita v={2} class="cm-f2" />
  <span class="brilho" style="--t:34px;left:22%;top:20%" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 1.5c.6 5.6 4.9 9.9 10.5 10.5-5.6.6-9.9 4.9-10.5 10.5C11.4 16.9 7.1 12.6 1.5 12 7.1 11.4 11.4 7.1 12 1.5z" /></svg></span>
  <span class="brilho" style="--t:26px;right:24%;bottom:22%;--d:6.5s" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 1.5c.6 5.6 4.9 9.9 10.5 10.5-5.6.6-9.9 4.9-10.5 10.5C11.4 16.9 7.1 12.6 1.5 12 7.1 11.4 11.4 7.1 12 1.5z" /></svg></span>
  <img class="cm-c cm-c1 flutua" src={C[0].corte} width={C[0].cw} height={C[0].ch} alt="" loading="lazy" style="--fd2:5.8s" />
  <img class="cm-c cm-c2 flutua" src={C[1].corte} width={C[1].cw} height={C[1].ch} alt="" loading="lazy" style="--fd2:5.4s" />
  <img class="cm-c cm-c3 flutua" src={C[2].corte} width={C[2].cw} height={C[2].ch} alt="" loading="lazy" style="--fd2:5.0s" />
  <div class="cm-tx cx">
    <h2 id="cm-t" class="tit">Do seu jeito, <em>em cada detalhe.</em></h2>
    <p class="sub">Cor do laço e do balão, cartão com a sua mensagem, retirada no {LOJA.bairro} ou entrega pela 99.</p>
    <a class="bt" href="#monte">Monte a sua cesta <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
  </div>
</section>

<style is:global>
  .cm { position: relative; overflow: clip; isolation: isolate; min-height: min(100svh, 860px); display: grid; align-items: center; background: radial-gradient(60% 50% at 50% 50%, var(--creme), transparent 70%), var(--clarinho); padding-block: 90px; }
  .cm-pal { position: absolute; inset: 0; z-index: -2; display: grid; align-content: space-between; padding-block: 5% 4%; pointer-events: none; }
  .cm-pal p { margin: 0; font-size: clamp(80px, 15vw, 230px); }
  .cm-r1 { translate: calc(-14% + var(--px, 0px)) 0; color: transparent; -webkit-text-stroke: 1.5px var(--rosa-cl); }
  .cm-r2 { translate: calc(-36% + var(--px, 0px)) 0; color: var(--gigante); }
  .cm-f1 { width: clamp(200px, 22vw, 360px); left: -50px; top: 4%; z-index: -1; }
  .cm-f2 { width: clamp(220px, 26vw, 420px); right: -40px; bottom: 2%; z-index: -1; }
  .cm-c { position: absolute; z-index: -1; height: auto; filter: drop-shadow(0 26px 22px rgba(110, 40, 55, 0.3)); translate: 0 var(--py, 0px); }
  .cm-c1 { width: clamp(150px, 17vw, 260px); left: 7%; bottom: 10%; rotate: -6deg; }
  .cm-c2 { width: clamp(120px, 13vw, 200px); right: 9%; top: 12%; rotate: 7deg; }
  .cm-c3 { width: clamp(110px, 11vw, 170px); right: 15%; bottom: 8%; rotate: -4deg; filter: blur(1.5px) drop-shadow(0 20px 18px rgba(110, 40, 55, 0.25)); }
  .cm-tx { position: relative; display: grid; justify-items: center; gap: 22px; text-align: center; translate: 0 var(--py, 0px); }
  .cm-tx .tit { font-size: clamp(40px, 6vw, 84px); max-width: 13ch; }
  .cm-tx .sub { max-width: 46ch; }
  @media (max-width: 700px) {
    .cm { min-height: 640px; }
    .cm-c1 { left: -4%; bottom: 3%; } .cm-c2 { right: -3%; top: 4%; } .cm-c3 { display: none; }
  }
</style>
