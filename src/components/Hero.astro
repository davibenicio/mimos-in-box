---
// Topo (mock do Davi): "PRESENTES" gigante e rosa atrás, a cesta girando num pedestal (quadros do vídeo gerado
// a partir da foto real da cesta), título em serifa marrom, fitas de cetim nas bordas e brilhos de quatro pontas.
// Composição centrada (pedido do Davi, 21/11 23h30): palavra no alto, cesta girando sem parar no meio, título e
// botões embaixo. Carrossel de três cestas: troca sozinho com barra de tempo, pausa visível, toque/arraste e teclado.
import { SLIDES } from '../data/loja';
import Fita from './Fita.astro';
import { porNN, reais } from '../data/catalogo';
import med from '../data/medidas-v3.json';
const M = med as Record<string, number[]>;
const ESTRELA = 'M12 1.5c.6 5.6 4.9 9.9 10.5 10.5-5.6.6-9.9 4.9-10.5 10.5C11.4 16.9 7.1 12.6 1.5 12 7.1 11.4 11.4 7.1 12 1.5z';
const GIG = 'PRESENTES';
const slides = SLIDES.map((s) => { const p = porNN(s.produto); const g = M['giro' + p.nn]; return { p, fw: g[0], fh: g[1], w0: g[2], h0: g[3] }; });
---
<section class="hr" data-hero data-gruda aria-roledescription="carrossel" aria-label="Cestas em destaque">
  <Fita v={1} class="hr-f1" />
  <Fita v={2} class="hr-f2" />
  <span class="brilho hr-b1" style="--t:38px;--d:5s" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={ESTRELA} /></svg></span>
  <span class="brilho hr-b2" style="--t:30px;--d:6.5s" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={ESTRELA} /></svg></span>
  <span class="brilho hr-b3" style="--t:26px;--d:4.5s" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={ESTRELA} /></svg></span>
  <span class="brilho hr-b4" style="--t:22px;--d:5.5s" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={ESTRELA} /></svg></span>

  <p class="gig hr-gig" aria-hidden="true">{[...GIG].map((l, i) => <span class="lt" style={`--i:${i}`}><b>{l}</b></span>)}</p>

  <div class="hr-palco" data-palco>
    <span class="hr-luz" aria-hidden="true"></span>
    <span class="hr-ped" aria-hidden="true"></span>
    {slides.map(({ p, fw, fh, w0, h0 }, i) => (
      <figure class:list={['hr-c', i === 0 && 'on']} data-slide data-nn={p.nn} aria-hidden={i === 0 ? 'false' : 'true'} style={`--ar:${fw}/${fh}`}>
        <span class="hr-cx">
        <img src={`/img/giro/${p.nn}-0.webp`} srcset={`/img/giro/${p.nn}-0p.webp 420w, /img/giro/${p.nn}-0.webp ${w0}w`} sizes="(max-width: 900px) 64vw, 520px"
          width={w0} height={h0} alt={p.nome} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} decoding="async" data-abre={p.nn} data-cur="ver" />
        <span class="hr-gira" data-gira={`/img/giro/${p.nn}.webp`} aria-hidden="true"></span>
        </span>
      </figure>
    ))}
    <div class="hr-ctl">
      <div class="hr-pts">{slides.map(({ p }, i) => <button type="button" class:list={[i === 0 && 'on']} data-ir={i} aria-label={`Mostrar ${p.nome}`}><i></i></button>)}</div>
      <button class="hr-pausa" type="button" data-pausa aria-pressed="false" aria-label="Pausar a troca automática"><svg viewBox="0 0 24 24" width="14" height="14"><path class="p1" d="M7 5v14M17 5v14" stroke="currentColor" stroke-width="3" stroke-linecap="round" /><path class="p2" d="M8 5l11 7-11 7z" fill="currentColor" /></svg></button>
    </div>
  </div>

  <div class="hr-txt cx">
    <h1 class="hr-t"><span>Pequenos gestos.</span> <span>Memórias enormes.</span></h1>
    <p class="hr-p">Presentes preparados com carinho para surpreender em cada ocasião.</p>
  </div>

  <div class="hr-b cx">
    <a class="bt" href="#cestas">Encontre seu mimo <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
    <a class="bt bt--linha" href="#promocoes">Conheça nossos kits <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
  </div>
</section>

<style is:global>
  /* altura da palavra: cabe na largura e na altura da tela */
  .hr { --F: min(18.5vw, 29vh); position: relative; z-index: 0; min-height: max(100svh, 640px); display: flex; flex-direction: column; align-items: center; padding: calc(var(--barra) + 10px) 0 clamp(18px, 3.4vh, 36px); background: var(--papel); overflow: clip; }
  .hr-f1 { left: -46px; top: -10px; width: clamp(200px, 24vw, 400px); }
  .hr-f2 { right: -40px; bottom: 6%; width: clamp(240px, 30vw, 500px); }
  .hr-b1 { right: 7%; top: 24%; } .hr-b2 { left: 6%; top: 54%; } .hr-b3 { right: 9%; bottom: 14%; } .hr-b4 { left: 16%; bottom: 18%; }

  /* a palavra gigante (Anton esticada, como no mock): letras sobem na chegada e depois ondulam sem parar */
  .hr-gig { position: absolute; left: 50%; top: calc(var(--barra) + 4px); z-index: 1; translate: -50% 0; scale: 1 1.42; transform-origin: 50% 0; font-size: var(--F); }
  .hr-gig .lt { display: inline-block; overflow: hidden; padding: 0.06em 0 0.05em; margin: -0.06em 0 -0.05em; }
  .hr-gig b { display: inline-block; font-weight: 400; animation: hr-onda 4.8s calc(var(--i) * -0.42s) ease-in-out infinite alternate; }
  html.js:not(.intro-viu):not(.abriu) .hr-gig b { transform: translateY(105%); }
  html.abriu:not(.intro-viu) .hr-gig b { animation: hr-letra 1.1s var(--sai) both, hr-onda 4.8s calc(1.2s + var(--i) * -0.42s) ease-in-out infinite alternate; animation-delay: calc(0.05s + var(--i) * 55ms), calc(1.2s + var(--i) * -0.42s); }
  @keyframes hr-letra { from { transform: translateY(105%); } to { transform: none; } }
  @keyframes hr-onda { from { transform: translateY(-2.5%); } to { transform: translateY(2.5%); } }

  /* palco centrado: luz, pedestal redondo e a cesta saindo de trás da palavra */
  .hr-palco { position: relative; z-index: 2; width: min(92vw, 860px); height: clamp(230px, 45vh, 540px); margin-top: calc(var(--F) * 0.6); flex: none; }
  .hr-luz { position: absolute; left: 14%; right: 14%; top: 4%; bottom: 10%; border-radius: 50%; background: radial-gradient(closest-side, color-mix(in srgb, var(--creme) 85%, transparent), transparent); animation: hr-respira 6s ease-in-out infinite alternate; }
  @keyframes hr-respira { to { scale: 1.08; opacity: 0.7; } }
  .hr-ped { position: absolute; left: 50%; bottom: -1%; width: min(84%, 660px); height: 13%; translate: -50% 0; border-radius: 0 0 50% 50% / 0 0 38% 38%; background: linear-gradient(180deg, var(--pedestal-1), var(--pedestal-2)); box-shadow: 0 26px 34px -26px rgba(120, 50, 60, 0.4); }
  .hr-ped::before { content: ''; position: absolute; left: 0; right: 0; top: -38%; height: 76%; border-radius: 50%; background: radial-gradient(60% 70% at 50% 40%, var(--creme), var(--pedestal-1)); }
  .hr-cx { position: absolute; left: 50%; bottom: 8%; height: 98%; max-width: 92%; aspect-ratio: var(--ar); translate: -50% 0; }
  .hr-c { position: absolute; inset: 0; margin: 0; pointer-events: none; opacity: 0; visibility: hidden; transform: translateX(10%) scale(0.94); transition: opacity 0.5s, transform 0.8s var(--sai), visibility 0s 0.8s; }
  .hr-c.on { opacity: 1; visibility: visible; transform: none; transition: opacity 0.6s 0.15s, transform 0.9s 0.1s var(--sai), visibility 0s; }
  .hr-c.sai { transform: translateX(-10%) scale(0.94); }
  .hr-c.on img { pointer-events: auto; }
  .hr-c img, .hr-gira { animation: hr-paira 4.5s ease-in-out infinite alternate; }
  @keyframes hr-paira { from { translate: 0 0; } to { translate: 0 -10px; } }
  .hr-c img { width: 100%; height: 100%; object-fit: contain; object-position: 50% 100%; filter: drop-shadow(0 24px 18px rgba(110, 45, 55, 0.28)); cursor: pointer; }
  .hr-gira { position: absolute; inset: 0; background-repeat: no-repeat; background-size: 400% 400%; background-position: 0 0; filter: drop-shadow(0 24px 18px rgba(110, 45, 55, 0.28)); opacity: 0; pointer-events: none; }
  .hr-c.gira-ok .hr-gira { opacity: 1; }
  .hr-c.gira-ok img { opacity: 0; }
  .hr-ctl { position: absolute; right: 0; bottom: 2%; z-index: 3; display: flex; align-items: center; gap: 2px; }
  .hr-pts { display: flex; }
  .hr-pts button { width: 34px; height: 40px; border: 0; background: none; padding: 0; display: grid; place-items: center; }
  .hr-pts i { position: relative; display: block; width: 7px; height: 7px; border-radius: 9px; background: var(--rosa-cl); overflow: hidden; transition: width 0.4s var(--sai); }
  .hr-pts .on i { width: 26px; background: color-mix(in srgb, var(--rosa) 25%, transparent); }
  .hr-pts .on i::after { content: ''; position: absolute; inset: 0; background: var(--rosa); transform-origin: 0 50%; transform: scaleX(var(--t, 0)); }
  .hr-pausa { width: 34px; height: 34px; border-radius: 50%; border: 0; background: transparent; color: var(--tinta-suave); display: grid; place-items: center; }
  .hr-pausa:hover { color: var(--tit); background: var(--pastel); }
  .hr-pausa .p2, .hr-pausa[aria-pressed='true'] .p1 { display: none; }
  .hr-pausa[aria-pressed='true'] .p2 { display: block; }

  /* texto centrado embaixo da cesta */
  .hr-txt { position: relative; z-index: 3; margin-top: clamp(10px, 2vh, 22px); text-align: center; }
  .hr-t { font-family: var(--f-serif); font-weight: 600; font-size: clamp(30px, min(3.8vw, 6.4vh), 62px); line-height: 1.05; letter-spacing: -0.02em; color: var(--tit); font-variation-settings: 'opsz' 72; }
  .hr-t span { display: inline; }
  .hr-p { margin: 10px auto 0; font-size: clamp(16px, min(1.4vw, 2.5vh), 22px); line-height: 1.4; max-width: 62ch; color: var(--tinta); }
  /* os botões ficam onde estava a faixa de baixo (pedido do Davi) */
  .hr-b { position: relative; z-index: 3; margin-top: clamp(16px, 3vh, 30px); display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; }
  .hr-b .bt { min-width: 240px; }
  html.js:not(.intro-viu) .hr-txt, html.js:not(.intro-viu) .hr-b { opacity: 0; }
  html.abriu:not(.intro-viu) .hr-txt, html.abriu:not(.intro-viu) .hr-b { animation: hr-sobe 0.9s 0.4s var(--sai) both; }
  html.abriu:not(.intro-viu) .hr-b { animation-delay: 0.55s; }
  @keyframes hr-sobe { from { opacity: 0; transform: translateY(26px); } to { opacity: 1; transform: none; } }

  @media (max-width: 900px) {
    .hr { --F: 21.4vw; min-height: auto; padding-bottom: 26px; }
    .hr-gig { top: calc(var(--barra) + 8px); scale: 1 1.36; }
    .hr-palco { width: 100%; height: min(68vw, 320px); margin-top: 22vw; }
    .hr-ctl { right: 10px; bottom: -4px; }
    .hr-t { font-size: clamp(30px, 8.6vw, 40px); }
    .hr-t span { display: block; }
    .hr-p { font-size: 15px; max-width: 30ch; }
    .hr-b { flex-direction: column; align-items: stretch; width: 100%; padding-inline: 20px; }
    .hr-b .bt { width: 100%; min-height: 54px; }
    .hr-f1 { left: -60px; top: 30px; width: 170px; } .hr-f2 { right: -70px; bottom: auto; top: 46%; width: 210px; }
    .hr-b1 { right: 4%; top: 36%; } .hr-b2, .hr-b4 { display: none; }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]')!;
  const slides = [...hero.querySelectorAll<HTMLElement>('[data-slide]')];
  const pts = [...hero.querySelectorAll<HTMLElement>('[data-ir]')];
  const pausa = hero.querySelector<HTMLButtonElement>('[data-pausa]')!;
  const calmo = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const DUR = 7000;
  let atual = 0, parado = calmo, segura = false, fora = false, gasto = 0, t0 = performance.now(), pronto = false;

  // ---- giro: os quadros da cesta virando (16 quadros num sprite 4x4) ----
  const carrega = (f: HTMLElement) => {
    const g = f.querySelector<HTMLElement>('[data-gira]')!;
    if (g.dataset.ok || calmo) return;
    g.dataset.ok = '1';
    const im = new Image(); im.decoding = 'async'; im.src = g.dataset.gira!;
    im.decode().then(() => { g.style.backgroundImage = `url(${im.src})`; f.classList.add('gira-ok'); }).catch(() => {});
  };
  const quadro = (f: HTMLElement, k: number) => {
    const i = Math.max(0, Math.min(15, Math.round(k)));
    f.querySelector<HTMLElement>('[data-gira]')!.style.backgroundPosition = `${(i % 4) * 33.3333}% ${Math.floor(i / 4) * 33.3333}%`;
  };
  // vai e volta devagar, como numa vitrine que gira; o mouse assume quando passa por cima
  let mouse = -1, mouseAte = 0;
  const vitrine = (t: number) => {
    // vai e volta sem parar (pedido do Davi: animação das cestas constante)
    return 7.5 - 7.5 * Math.cos((t / 4200) * Math.PI);
  };

  const ir = (n: number) => {
    const novo = (n + slides.length) % slides.length; if (novo === atual) return;
    slides[atual].classList.remove('on'); slides[atual].classList.add('sai'); slides[atual].setAttribute('aria-hidden', 'true');
    const velho = slides[atual]; setTimeout(() => velho.classList.remove('sai'), 900);
    pts[atual].classList.remove('on'); pts[atual].style.removeProperty('--t');
    atual = novo;
    slides[atual].classList.add('on'); slides[atual].setAttribute('aria-hidden', 'false'); carrega(slides[atual]);
    pts[atual].classList.add('on'); gasto = 0;
  };
  const segurar = () => { segura = true; clearTimeout((segurar as any).t); (segurar as any).t = setTimeout(() => (segura = false), 6000); };
  pts.forEach((b, i) => b.addEventListener('click', () => { ir(i); segurar(); }));
  pausa.addEventListener('click', () => { parado = !parado; pausa.setAttribute('aria-pressed', String(parado)); pausa.setAttribute('aria-label', parado ? 'Retomar a troca automática' : 'Pausar a troca automática'); });
  if (calmo) { pausa.setAttribute('aria-pressed', 'true'); pausa.setAttribute('aria-label', 'Retomar a troca automática'); }
  hero.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') { ir(atual - 1); segurar(); } if (e.key === 'ArrowRight') { ir(atual + 1); segurar(); } });
  // arrastar no celular troca a cesta
  let x0 = 0, y0 = 0;
  hero.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; }, { passive: true });
  hero.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - x0, dy = e.changedTouches[0].clientY - y0; if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy) * 1.4) { ir(atual + (dx < 0 ? 1 : -1)); segurar(); } }, { passive: true });
  const palco = hero.querySelector<HTMLElement>('[data-palco]')!;
  hero.addEventListener('focusin', () => (segura = true)); hero.addEventListener('focusout', () => (segura = false));
  new IntersectionObserver(([e]) => { fora = !e.isIntersecting; document.documentElement.classList.toggle('no-hero', e.isIntersecting); }, { threshold: 0.2 }).observe(hero);

  let k = 0;
  const tick = (t: number) => {
    if (!fora) {
      const f = slides[atual];
      if (f.classList.contains('gira-ok')) { k = vitrine(t); quadro(f, k); }
      if (pronto && !parado && !segura) { gasto += t - t0; if (gasto >= DUR) ir(atual + 1); }
      pts[atual].style.setProperty('--t', String(Math.min(1, gasto / DUR)));
    }
    t0 = t; requestAnimationFrame(tick);
  };
  const liga = () => { pronto = true; setTimeout(() => carrega(slides[0]), 300); };
  if (document.documentElement.classList.contains('abriu')) liga(); else addEventListener('mimos:abriu', liga, { once: true });
  requestAnimationFrame(tick);
</script>
