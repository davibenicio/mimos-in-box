---
// Topo (mock do Davi): "PRESENTES" gigante e rosa atrás, a cesta girando num pedestal (quadros do vídeo gerado
// a partir da foto real da cesta), título em serifa marrom, fitas de cetim nas bordas e brilhos de quatro pontas.
// Carrossel de três cestas: troca sozinho com barra de tempo, pausa visível, toque/arraste e teclado.
import { SLIDES, LOJA } from '../data/loja';
import { porNN, reais } from '../data/catalogo';
import med from '../data/medidas-v3.json';
const M = med as Record<string, number[]>;
const ESTRELA = 'M12 1.5c.6 5.6 4.9 9.9 10.5 10.5-5.6.6-9.9 4.9-10.5 10.5C11.4 16.9 7.1 12.6 1.5 12 7.1 11.4 11.4 7.1 12 1.5z';
const GIG = 'PRESENTES';
const slides = SLIDES.map((s) => { const p = porNN(s.produto); const g = M['giro' + p.nn]; return { p, fw: g[0], fh: g[1], w0: g[2], h0: g[3] }; });
const FEITOS = [
  ['Feito à mão com carinho', 'M12 20.5s-7.5-4.6-7.5-10.2A4.3 4.3 0 0 1 12 7.6a4.3 4.3 0 0 1 7.5 2.7c0 5.6-7.5 10.2-7.5 10.2z'],
  ['Presentes personalizados', 'M4 9.5h16v3H4zM5.5 12.5h13V20h-13zM12 9.5V20M12 9.5c-2.6 0-4.4-1-4.1-2.6.4-1.9 3-1.2 4.1 2.6zm0 0c2.6 0 4.4-1 4.1-2.6-.4-1.9-3-1.2-4.1 2.6z'],
  ['Cada detalhe importa', 'M12 3.5l2.5 5.3 5.8.7-4.3 4 1.1 5.7L12 16.4l-5.1 2.8 1.1-5.7-4.3-4 5.8-.7z'],
];
---
<section class="hr" data-hero data-gruda aria-roledescription="carrossel" aria-label="Cestas em destaque">
  <svg class="hr-fita hr-f1" viewBox="0 0 420 620" aria-hidden="true" data-par="-0.4"><defs><linearGradient id="hr-fg1" x1="0" y1="0" x2="1" y2="1"><stop offset="0" style="stop-color:var(--fita-1)" /><stop offset=".5" style="stop-color:var(--fita-2)" /><stop offset="1" style="stop-color:var(--fita-1)" /></linearGradient></defs><path d="M150 -30C118 60 58 122 70 206c12 92 128 116 146 44 18-72-92-104-152-52C4 250-6 340-70 440" /></svg>
  <svg class="hr-fita hr-f2" viewBox="0 0 520 640" aria-hidden="true" data-par="0.5"><defs><linearGradient id="hr-fg2" x1="1" y1="0" x2="0" y2="1"><stop offset="0" style="stop-color:var(--fita-1)" /><stop offset=".5" style="stop-color:var(--fita-2)" /><stop offset="1" style="stop-color:var(--fita-1)" /></linearGradient></defs><path d="M600 10C480 50 372 130 356 246c-16 120 116 178 160 98 44-80-70-140-140-80C300 330 318 480 600 640" /></svg>
  <span class="brilho hr-b1" style="--t:38px;--d:5s" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={ESTRELA} /></svg></span>
  <span class="brilho hr-b2" style="--t:30px;--d:6.5s" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={ESTRELA} /></svg></span>
  <span class="brilho hr-b3" style="--t:26px;--d:4.5s" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={ESTRELA} /></svg></span>

  <p class="gig hr-gig" aria-hidden="true" data-parx="-0.25">{[...GIG].map((l, i) => <span class="lt" style={`--i:${i}`}><b>{l}</b></span>)}</p>

  <div class="hr-g cx">
    <div class="hr-txt">
      <h1 class="hr-t"><span>Pequenos gestos.</span> <span>Memórias enormes.</span></h1>
      <p class="hr-p">Presentes preparados com carinho<br />para surpreender em cada ocasião.</p>
      <div class="hr-b">
        <a class="bt" href="#cestas">Encontre seu mimo <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
        <a class="lk" href="#promocoes">Conheça nossos kits <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <div class="hr-palco" data-palco>
      <span class="hr-luz" aria-hidden="true"></span>
      <span class="hr-ped" aria-hidden="true"></span>
      {slides.map(({ p, fw, fh, w0, h0 }, i) => (
        <figure class:list={['hr-c', i === 0 && 'on']} data-slide data-nn={p.nn} aria-hidden={i === 0 ? 'false' : 'true'} style={`--ar:${fw}/${fh}`}>
          <span class="hr-cx">
          <img src={`/img/giro/${p.nn}-0.webp`} srcset={`/img/giro/${p.nn}-0p.webp 420w, /img/giro/${p.nn}-0.webp ${w0}w`} sizes="(max-width: 900px) 64vw, 520px"
            width={w0} height={h0} alt={p.nome} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} decoding="async" data-abre={p.nn} data-cur="ver" />
          <span class="hr-gira" data-gira={`/img/giro/${p.nn}.webp`} aria-hidden="true"></span>
          </span>
        </figure>
      ))}
      <div class="hr-ctl">
        <div class="hr-pts">{slides.map(({ p }, i) => <button type="button" class:list={[i === 0 && 'on']} data-ir={i} aria-label={`Mostrar ${p.nome}`}><i></i></button>)}</div>
        <button class="hr-pausa" type="button" data-pausa aria-pressed="false" aria-label="Pausar a troca automática"><svg viewBox="0 0 24 24" width="14" height="14"><path class="p1" d="M7 5v14M17 5v14" stroke="currentColor" stroke-width="3" stroke-linecap="round" /><path class="p2" d="M8 5l11 7-11 7z" fill="currentColor" /></svg></button>
      </div>
    </div>
  </div>

  <ul class="hr-feitos cx">
    {FEITOS.map(([t, d]) => <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d={d} /></svg>{t}</li>)}
  </ul>
</section>

<style is:global>
  .hr { position: relative; z-index: 0; min-height: max(100svh, 700px); display: flex; flex-direction: column; padding-top: calc(var(--barra) + 18px); background: var(--papel); overflow: clip; }
  .hr::after { content: ''; position: absolute; inset: 0; z-index: 9; background: var(--fixo-escuro); opacity: calc(var(--cobre, 0) * 0.32); pointer-events: none; }
  .hr-fita { position: absolute; z-index: 0; overflow: visible; pointer-events: none; translate: 0 var(--py, 0px); }
  .hr-fita path { fill: none; stroke-width: 46; stroke-linecap: butt; }
  .hr-f1 { left: -46px; top: -10px; width: clamp(220px, 25vw, 420px); } .hr-f1 path { stroke: url(#hr-fg1); }
  .hr-f2 { right: -40px; bottom: 30px; width: clamp(260px, 31vw, 520px); } .hr-f2 path { stroke: url(#hr-fg2); }
  .hr-b1 { right: 7%; top: 23%; } .hr-b2 { left: 5%; top: 50%; } .hr-b3 { right: 6%; bottom: 10%; }

  /* a palavra gigante (Anton esticada na vertical, como no mock): letras sobem de dentro da linha */
  .hr-gig { position: absolute; left: 50%; top: calc(var(--barra) + 46px); z-index: 1; translate: calc(-50% + var(--px, 0px)) 0; scale: 1 1.42; transform-origin: 50% 0; font-size: min(19.2vw, 330px); }
  .hr-gig .lt { display: inline-block; overflow: hidden; padding-top: 0.06em; margin-top: -0.06em; }
  .hr-gig b { display: inline-block; font-weight: 400; }
  html.js:not(.intro-viu) .hr-gig b { transform: translateY(105%); }
  html.abriu:not(.intro-viu) .hr-gig b { animation: hr-letra 1.1s var(--sai) both; animation-delay: calc(0.05s + var(--i) * 55ms); }
  @keyframes hr-letra { from { transform: translateY(105%); } to { transform: none; } }

  .hr-g { position: static; flex: 1; display: flex; align-items: flex-end; translate: 0 calc(var(--cobre, 0) * -50px); }
  .hr-txt { position: relative; z-index: 3; width: min(46%, 600px); padding-bottom: clamp(40px, 7vh, 72px); }
  .hr-t { font-family: var(--f-serif); font-weight: 600; font-size: clamp(40px, 3.7vw, 64px); line-height: 1.04; letter-spacing: -0.02em; color: var(--tit); font-variation-settings: 'opsz' 72; }
  .hr-t span { display: block; }
  .hr-p { margin-top: 16px; font-size: clamp(17px, 1.45vw, 24px); line-height: 1.4; max-width: 32ch; color: var(--tinta); }
  .hr-b { margin-top: 30px; display: flex; flex-wrap: wrap; align-items: center; gap: 16px 32px; }
  html.js:not(.intro-viu) .hr-txt > * { opacity: 0; transform: translateY(26px); }
  html.abriu:not(.intro-viu) .hr-txt > * { animation: hr-sobe 0.9s 0.35s var(--sai) both; }
  html.abriu:not(.intro-viu) .hr-txt > :nth-child(2) { animation-delay: 0.47s; } html.abriu:not(.intro-viu) .hr-txt > :nth-child(3) { animation-delay: 0.57s; }
  @keyframes hr-sobe { from { opacity: 0; transform: translateY(26px); } to { opacity: 1; transform: none; } }

  /* palco à direita (mock): luz, pedestal redondo e a cesta saindo de trás da palavra */
  .hr-palco { position: absolute; z-index: 2; left: 44%; right: 8%; top: max(23%, 170px); bottom: 86px; }
  .hr-luz { position: absolute; left: 6%; right: 6%; top: 6%; bottom: 12%; border-radius: 50%; background: radial-gradient(closest-side, color-mix(in srgb, var(--creme) 80%, transparent), transparent); }
  .hr-ped { position: absolute; left: 50%; bottom: -2%; width: min(104%, 760px); height: 15%; translate: -50% 0; border-radius: 0 0 50% 50% / 0 0 38% 38%; background: linear-gradient(180deg, var(--pedestal-1), var(--pedestal-2)); box-shadow: 0 26px 34px -26px rgba(120, 50, 60, 0.4); }
  .hr-ped::before { content: ''; position: absolute; left: 0; right: 0; top: -38%; height: 76%; border-radius: 50%; background: radial-gradient(60% 70% at 50% 40%, var(--creme), var(--pedestal-1)); box-shadow: inset 0 -2px 6px rgba(120, 50, 60, 0.06); }
  .hr-cx { position: absolute; left: 50%; bottom: 9%; height: 96%; max-width: 106%; aspect-ratio: var(--ar); translate: -50% 0; }
  .hr-c { position: absolute; inset: 0; margin: 0; pointer-events: none; opacity: 0; visibility: hidden; transform: translateX(10%) scale(0.94); transition: opacity 0.5s, transform 0.8s var(--sai), visibility 0s 0.8s; }
  .hr-c.on { opacity: 1; visibility: visible; transform: none; transition: opacity 0.6s 0.15s, transform 0.9s 0.1s var(--sai), visibility 0s; }
  .hr-c.sai { transform: translateX(-10%) scale(0.94); }
  .hr-c.on img { pointer-events: auto; }
  .hr-c img { width: 100%; height: 100%; object-fit: contain; object-position: 50% 100%; filter: drop-shadow(0 24px 18px rgba(110, 45, 55, 0.28)); cursor: pointer; }
  .hr-gira { position: absolute; inset: 0; background-repeat: no-repeat; background-size: 400% 400%; background-position: 0 0; filter: drop-shadow(0 24px 18px rgba(110, 45, 55, 0.28)); opacity: 0; pointer-events: none; }
  .hr-c.gira-ok .hr-gira { opacity: 1; }
  .hr-c.gira-ok img { opacity: 0; }
  .hr-ctl { position: absolute; left: 50%; bottom: -46px; translate: -50% 0; z-index: 3; display: flex; align-items: center; gap: 2px; }
  .hr-pts { display: flex; }
  .hr-pts button { width: 34px; height: 40px; border: 0; background: none; padding: 0; display: grid; place-items: center; }
  .hr-pts i { position: relative; display: block; width: 7px; height: 7px; border-radius: 9px; background: var(--rosa-cl); overflow: hidden; transition: width 0.4s var(--sai); }
  .hr-pts .on i { width: 26px; background: color-mix(in srgb, var(--rosa) 25%, transparent); }
  .hr-pts .on i::after { content: ''; position: absolute; inset: 0; background: var(--rosa); transform-origin: 0 50%; transform: scaleX(var(--t, 0)); }
  .hr-pausa { width: 34px; height: 34px; border-radius: 50%; border: 0; background: transparent; color: var(--tinta-suave); display: grid; place-items: center; }
  .hr-pausa:hover { color: var(--tit); background: var(--pastel); }
  .hr-pausa .p2, .hr-pausa[aria-pressed='true'] .p1 { display: none; }
  .hr-pausa[aria-pressed='true'] .p2 { display: block; }

  /* faixa de baixo (mock): três ideias com ícone e divisória */
  .hr-feitos { position: relative; z-index: 3; display: flex; justify-content: center; border-top: 1px solid var(--linha); margin-top: 0; padding-block: 22px 24px; }
  .hr-feitos li { display: flex; align-items: center; gap: 14px; padding-inline: clamp(18px, 4vw, 54px); font-size: 17px; font-weight: 500; color: var(--tit); }
  .hr-feitos li + li { border-left: 1px solid var(--rosa-cl); }
  .hr-feitos svg { width: 30px; height: 30px; fill: none; stroke: var(--rosa); stroke-width: 1.5; stroke-linejoin: round; stroke-linecap: round; }

  @media (max-width: 900px) {
    .hr { min-height: auto; padding-top: calc(var(--barra) + 6px); }
    .hr-gig { font-size: 21.6vw; top: calc(var(--barra) + 10px); scale: 1 1.36; }
    .hr-g { flex-direction: column; align-items: stretch; }
    .hr-palco { order: -1; position: relative; left: auto; right: auto; top: auto; bottom: auto; height: min(70vw, 320px); margin-top: 22vw; }
    .hr-cx { height: 94%; }
    .hr-ctl { bottom: -40px; }
    .hr-txt { width: auto; padding: 34px 0 26px; text-align: center; }
    .hr-t { font-size: clamp(32px, 9vw, 42px); }
    .hr-p { margin: 8px auto 0; font-size: 15px; }
    .hr-b { justify-content: center; margin-top: 18px; gap: 12px 22px; }
    .hr-b .bt { width: 100%; min-height: 56px; }
    .hr-f1 { left: -60px; top: 30px; width: 170px; } .hr-f2 { right: -70px; bottom: auto; top: 46%; width: 210px; }
    .hr-b1 { right: 4%; top: 36%; } .hr-b2 { display: none; }
    .hr-feitos { flex-direction: column; align-items: center; gap: 10px; padding-block: 18px 22px; }
    .hr-feitos li + li { border-left: 0; }
    .hr-feitos li { font-size: 15.5px; padding: 0; }
    .hr-feitos svg { width: 24px; height: 24px; }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]')!;
  const slides = [...hero.querySelectorAll<HTMLElement>('[data-slide]')];
  const pts = [...hero.querySelectorAll<HTMLElement>('[data-ir]')];
  const pausa = hero.querySelector<HTMLButtonElement>('[data-pausa]')!;
  const calmo = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const DUR = 7000;
  let atual = 0, parado = calmo, segura = false, fora = false, gasto = 0, t0 = performance.now(), pronto = false;

  // ---- giro: os quadros da cesta virando (16 quadros num sprite 4x4) ----
  const carrega = (f: HTMLElement) => {
    const g = f.querySelector<HTMLElement>('[data-gira]')!;
    if (g.dataset.ok || calmo) return;
    g.dataset.ok = '1';
    const im = new Image(); im.decoding = 'async'; im.src = g.dataset.gira!;
    im.decode().then(() => { g.style.backgroundImage = `url(${im.src})`; f.classList.add('gira-ok'); }).catch(() => {});
  };
  const quadro = (f: HTMLElement, k: number) => {
    const i = Math.max(0, Math.min(15, Math.round(k)));
    f.querySelector<HTMLElement>('[data-gira]')!.style.backgroundPosition = `${(i % 4) * 33.3333}% ${Math.floor(i / 4) * 33.3333}%`;
  };
  // vai e volta devagar, como numa vitrine que gira; o mouse assume quando passa por cima
  let mouse = -1, mouseAte = 0;
  const vitrine = (t: number) => {
    const ciclo = 6200, f = (t % ciclo) / ciclo;
    const e = (x: number) => 0.5 - Math.cos(Math.PI * x) / 2;
    return 15 * (f < 0.3 ? e(f / 0.3) : f < 0.5 ? 1 : f < 0.8 ? 1 - e((f - 0.5) / 0.3) : 0);
  };

  const ir = (n: number) => {
    const novo = (n + slides.length) % slides.length; if (novo === atual) return;
    slides[atual].classList.remove('on'); slides[atual].classList.add('sai'); slides[atual].setAttribute('aria-hidden', 'true');
    const velho = slides[atual]; setTimeout(() => velho.classList.remove('sai'), 900);
    pts[atual].classList.remove('on'); pts[atual].style.removeProperty('--t');
    atual = novo;
    slides[atual].classList.add('on'); slides[atual].setAttribute('aria-hidden', 'false'); carrega(slides[atual]);
    pts[atual].classList.add('on'); gasto = 0;
  };
  const segurar = () => { segura = true; clearTimeout((segurar as any).t); (segurar as any).t = setTimeout(() => (segura = false), 6000); };
  pts.forEach((b, i) => b.addEventListener('click', () => { ir(i); segurar(); }));
  pausa.addEventListener('click', () => { parado = !parado; pausa.setAttribute('aria-pressed', String(parado)); pausa.setAttribute('aria-label', parado ? 'Retomar a troca automática' : 'Pausar a troca automática'); });
  if (calmo) { pausa.setAttribute('aria-pressed', 'true'); pausa.setAttribute('aria-label', 'Retomar a troca automática'); }
  hero.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') { ir(atual - 1); segurar(); } if (e.key === 'ArrowRight') { ir(atual + 1); segurar(); } });
  // arrastar no celular troca a cesta
  let x0 = 0, y0 = 0;
  hero.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; }, { passive: true });
  hero.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - x0, dy = e.changedTouches[0].clientY - y0; if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy) * 1.4) { ir(atual + (dx < 0 ? 1 : -1)); segurar(); } }, { passive: true });
  const palco = hero.querySelector<HTMLElement>('[data-palco]')!;
  if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
    palco.addEventListener('pointermove', (e) => { const r = palco.getBoundingClientRect(); mouse = Math.max(0, Math.min(1, (e.clientX - r.left) / r.width)) * 15; mouseAte = performance.now() + 1800; segura = true; });
    palco.addEventListener('pointerleave', () => { segura = false; });
  }
  hero.addEventListener('focusin', () => (segura = true)); hero.addEventListener('focusout', () => (segura = false));
  new IntersectionObserver(([e]) => { fora = !e.isIntersecting; document.documentElement.classList.toggle('no-hero', e.isIntersecting); }, { threshold: 0.2 }).observe(hero);

  let k = 0;
  const tick = (t: number) => {
    if (!fora) {
      const f = slides[atual];
      if (f.classList.contains('gira-ok')) { const alvo = t < mouseAte && mouse >= 0 ? mouse : vitrine(t); k += (alvo - k) * 0.12; quadro(f, k); }
      if (pronto && !parado && !segura) { gasto += t - t0; if (gasto >= DUR) ir(atual + 1); }
      pts[atual].style.setProperty('--t', String(Math.min(1, gasto / DUR)));
    }
    t0 = t; requestAnimationFrame(tick);
  };
  const liga = () => { pronto = true; setTimeout(() => carrega(slides[0]), 300); };
  if (document.documentElement.classList.contains('abriu')) liga(); else addEventListener('mimos:abriu', liga, { once: true });
  requestAnimationFrame(tick);
</script>
