---
// Topo (mock do Davi): "PRESENTES" gigante e rosa atrás, a cesta girando num pedestal (quadros do vídeo gerado
// a partir da foto real da cesta), título em serifa marrom, fitas de cetim nas bordas e brilhos de quatro pontas.
// Composição do mock (texto à esquerda, cesta à direita), com os botões embaixo, no lugar da faixa de três ideias. Carrossel de três cestas: troca sozinho com barra de tempo, pausa visível, toque/arraste e teclado.
import { SLIDES } from '../data/loja';
import Fita from './Fita.astro';
import { porNN, reais } from '../data/catalogo';
import med from '../data/medidas-v3.json';
const M = med as Record<string, number[]>;
const ESTRELA = 'M12 1.5c.6 5.6 4.9 9.9 10.5 10.5-5.6.6-9.9 4.9-10.5 10.5C11.4 16.9 7.1 12.6 1.5 12 7.1 11.4 11.4 7.1 12 1.5z';
const GIG = 'PRESENTES';
const slides = SLIDES.map((s) => { const p = porNN(s.produto); const g = M['giro' + p.nn]; return { p, fw: g[0], fh: g[1], w0: g[2], h0: g[3], n: g[4], cols: g[5], vg: g[6] ? `${g[6]}x${g[7]}` : '', vp: g[8] ? `${g[8]}x${g[9]}` : '' }; });
---
<section class="hr grad" data-hero data-gruda aria-roledescription="carrossel" aria-label="Cestas em destaque">
  <Fita v={1} class="hr-f1" />
  <Fita v={2} class="hr-f2" />
  <span class="brilho hr-b1" style="--t:38px;--d:5s" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={ESTRELA} /></svg></span>
  <span class="brilho hr-b2" style="--t:30px;--d:6.5s" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={ESTRELA} /></svg></span>
  <span class="brilho hr-b3" style="--t:26px;--d:4.5s" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={ESTRELA} /></svg></span>
  <span class="brilho hr-b4" style="--t:22px;--d:5.5s" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={ESTRELA} /></svg></span>

  <p class="gig hr-gig" aria-hidden="true">{[...GIG].map((l, i) => <span class="lt" style={`--i:${i}`}><b>{l}</b></span>)}</p>

  <div class="hr-palco" data-palco>
    <span class="hr-luz" aria-hidden="true"></span>
    <span class="hr-ped" aria-hidden="true"></span>
    {slides.map(({ p, fw, fh, w0, h0, n, cols, vg, vp }, i) => (
      <figure class:list={['hr-c', i === 0 && 'on']} data-slide data-nn={p.nn} data-n={n} data-cols={cols} aria-hidden={i === 0 ? 'false' : 'true'} style={`--ar:${fw}/${fh};--cols:${cols};--rows:${Math.ceil(n / cols)}`}>
        <span class="hr-cx">
        <img src={`/img/giro/${p.nn}-0.webp`} srcset={`/img/giro/${p.nn}-0p.webp 420w, /img/giro/${p.nn}-0.webp ${w0}w`} sizes="(max-width: 900px) 64vw, 520px"
          width={w0} height={h0} alt={p.nome} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} decoding="async" data-abre={p.nn} data-cur="ver" />
        <span class="hr-gira" data-gira={`/img/giro/${p.nn}.webp`} aria-hidden="true"></span><span class="hr-gira hr-gira-b" aria-hidden="true"></span>
        {vg && <canvas class="hr-vid" data-vid={p.nn} data-g={vg} data-p={vp} aria-hidden="true"></canvas>}
        </span>
      </figure>
    ))}
    <div class="hr-ctl">
      <div class="hr-pts">{slides.map(({ p }, i) => <button type="button" class:list={[i === 0 && 'on']} data-ir={i} aria-label={`Mostrar ${p.nome}`}><i></i></button>)}</div>
      <button class="hr-pausa" type="button" data-pausa aria-pressed="false" aria-label="Pausar a troca automática"><svg viewBox="0 0 24 24" width="14" height="14"><path class="p1" d="M7 5v14M17 5v14" stroke="currentColor" stroke-width="3" stroke-linecap="round" /><path class="p2" d="M8 5l11 7-11 7z" fill="currentColor" /></svg></button>
    </div>
  </div>

  <div class="hr-txt cx">
    <h1 class="hr-t"><span>Pequenos gestos.</span> <span>Memórias enormes.</span></h1>
    <p class="hr-p">Presentes preparados com carinho para surpreender em cada ocasião.</p>
  </div>

  <div class="hr-b cx">
    <a class="bt" href="#cestas">Encontre seu mimo <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
    <a class="bt bt--linha" href="#promocoes">Conheça nossos kits <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
  </div>
</section>

<style is:global>
  /* altura da palavra: cabe na largura e na altura da tela (antes quebrava em telas baixas) */
  .hr { --F: min(19.2vw, 30vh); position: relative; z-index: 0; min-height: max(100svh, 640px); display: flex; flex-direction: column; padding-top: calc(var(--barra) + 10px); overflow: clip; }
  .hr-f1 { left: -46px; top: -10px; width: clamp(200px, 24vw, 400px); }
  .hr-f2 { right: -40px; bottom: 12%; width: clamp(240px, 30vw, 500px); }
  .hr-b1 { right: 7%; top: 24%; } .hr-b2 { left: 5%; top: 52%; } .hr-b3 { right: 5%; bottom: 20%; } .hr-b4 { left: 40%; bottom: 24%; }

  /* "PRESENTES" (Anton esticada, como no mock; o Davi testou uma fina e preferiu esta) com degradê rosa → claro; as letras ondulam sem parar */
  .hr-gig { position: absolute; left: 50%; top: calc(var(--barra) + 74px); z-index: 1; translate: -50% 0; scale: 1 1.42; transform-origin: 50% 0; font-size: var(--F); }
  .hr-gig .lt { display: inline-block; overflow: hidden; padding: 0.16em 0 0.06em; margin: -0.16em 0 -0.06em; }
  .hr-gig b { display: inline-block; padding-top: 0.1em; margin-top: -0.1em; font-weight: 400; background: var(--grad-gig); background-size: 100% 220%; -webkit-background-clip: text; background-clip: text; color: transparent; animation: hr-onda 3s calc(var(--i) * -0.3s) ease-in-out infinite alternate, grad-sobe 5s calc(var(--i) * -0.4s) ease-in-out infinite alternate; }
  html.js:not(.intro-viu):not(.abriu) .hr-gig b { transform: translateY(105%); }
  html.abriu:not(.intro-viu) .hr-gig b { animation: hr-letra 1.1s var(--sai) both, hr-onda 3s ease-in-out infinite alternate, grad-sobe 5s ease-in-out infinite alternate; animation-delay: calc(0.05s + var(--i) * 55ms), calc(1.2s + var(--i) * -0.3s), calc(var(--i) * -0.4s); }
  @keyframes hr-letra { from { transform: translateY(105%); } to { transform: none; } }
  @keyframes hr-onda { from { transform: translateY(-2.5%); } to { transform: translateY(2.5%); } }

  /* texto à esquerda, embaixo da palavra (mock) */
  .hr-txt { position: relative; z-index: 3; flex: 1; display: flex; flex-direction: column; justify-content: flex-end; padding-top: calc(var(--F) * 1.12 + 56px); padding-bottom: clamp(18px, 3.5vh, 40px); }
  .hr-t { max-width: 10em; font-family: var(--f-serif); font-weight: 600; font-size: clamp(34px, min(4.2vw, 7.4vh), 66px); line-height: 1.04; letter-spacing: -0.02em; color: var(--tit); font-variation-settings: 'opsz' 72; }
  .hr-t span { display: block; }
  .hr-p { margin-top: 18px; max-width: min(40%, 32ch); font-size: clamp(17px, min(1.75vw, 3vh), 27px); line-height: 1.4; color: var(--tinta); }
  html.js:not(.intro-viu) .hr-txt, html.js:not(.intro-viu) .hr-b { opacity: 0; }
  html.abriu:not(.intro-viu) .hr-txt, html.abriu:not(.intro-viu) .hr-b { animation: hr-sobe 0.9s 0.4s var(--sai) both; }
  html.abriu:not(.intro-viu) .hr-b { animation-delay: 0.55s; }
  @keyframes hr-sobe { from { opacity: 0; transform: translateY(26px); } to { opacity: 1; transform: none; } }

  /* palco à direita (mock): luz, pedestal redondo e a cesta saindo de trás da palavra */
  .hr-palco { position: absolute; z-index: 2; left: max(41%, calc(50% - 40px)); right: 3%; top: calc(var(--barra) + var(--F) * 0.42 + 56px); bottom: calc(clamp(18px, 3vh, 30px) * 2 + 54px + 2px); }
  .hr-luz { position: absolute; left: 6%; right: 6%; top: 4%; bottom: 10%; border-radius: 50%; background: radial-gradient(closest-side, color-mix(in srgb, var(--creme) 80%, transparent), transparent); animation: hr-respira 6s ease-in-out infinite alternate; }
  @keyframes hr-respira { to { scale: 1.08; opacity: 0.7; } }
  .hr-ped { position: absolute; left: 50%; bottom: -1%; width: min(96%, 720px); height: 13%; translate: -50% 0; border-radius: 0 0 50% 50% / 0 0 38% 38%; background: linear-gradient(180deg, var(--pedestal-1), var(--pedestal-2)); box-shadow: 0 26px 34px -26px rgba(120, 50, 60, 0.4); }
  .hr-ped::before { content: ''; position: absolute; left: 0; right: 0; top: -38%; height: 76%; border-radius: 50%; background: radial-gradient(60% 70% at 50% 40%, var(--creme), var(--pedestal-1)); }
  .hr-cx { position: absolute; left: 50%; bottom: 7%; height: 100%; max-width: 100%; aspect-ratio: var(--ar); translate: -50% 0; }
  .hr-c { position: absolute; inset: 0; margin: 0; pointer-events: none; opacity: 0; visibility: hidden; transform: translateX(10%) scale(0.94); transition: opacity 0.5s, transform 0.8s var(--sai), visibility 0s 0.8s; }
  .hr-c.on { opacity: 1; visibility: visible; transform: none; transition: opacity 0.6s 0.15s, transform 0.9s 0.1s var(--sai), visibility 0s; }
  .hr-c.sai { transform: translateX(-10%) scale(0.94); }
  .hr-c.on img { pointer-events: auto; }
  .hr-cx { animation: hr-paira 4.5s ease-in-out infinite alternate; }
  @keyframes hr-paira { from { margin-bottom: 0; } to { margin-bottom: 10px; } }
  .hr-c img { width: 100%; height: 100%; object-fit: contain; object-position: 50% 100%; filter: drop-shadow(0 24px 18px rgba(110, 45, 55, 0.28)); cursor: pointer; }
  /* duas camadas de quadros: a segunda mostra o quadro seguinte e aparece aos poucos (giro fluido) */
  .hr-gira { position: absolute; inset: 0; background-repeat: no-repeat; background-size: calc(var(--cols) * 100%) calc(var(--rows) * 100%); background-position: 0 0; opacity: 0; pointer-events: none; }
  .hr-gira:not(.hr-gira-b) { filter: drop-shadow(0 24px 18px rgba(110, 45, 55, 0.28)); }
  .hr-c.gira-ok .hr-gira:not(.hr-gira-b) { opacity: 1; }
  /* vídeo da cesta (cor em cima, transparência embaixo, juntadas num canvas WebGL): quando roda, cobre a foto e os quadros */
  .hr-vid { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 0.45s; pointer-events: none; }
  .hr-c.vid-ok .hr-vid { opacity: 1; }
  .hr-c.vid-ok img, .hr-c.vid-ok .hr-gira { opacity: 0; transition: opacity 0.45s; }
  .hr-c.gira-ok img { opacity: 0; }
  .hr-ctl { position: absolute; right: 0; bottom: 2%; z-index: 3; display: flex; align-items: center; gap: 2px; }
  .hr-pts { display: flex; }
  .hr-pts button { width: 34px; height: 40px; border: 0; background: none; padding: 0; display: grid; place-items: center; }
  .hr-pts i { position: relative; display: block; width: 7px; height: 7px; border-radius: 9px; background: var(--rosa-cl); overflow: hidden; transition: width 0.4s var(--sai); }
  .hr-pts .on i { width: 26px; background: color-mix(in srgb, var(--rosa) 25%, transparent); }
  .hr-pts .on i::after { content: ''; position: absolute; inset: 0; background: var(--rosa); transform-origin: 0 50%; transform: scaleX(var(--t, 0)); }
  .hr-pausa { width: 34px; height: 34px; border-radius: 50%; border: 0; background: transparent; color: var(--tinta-suave); display: grid; place-items: center; }
  .hr-pausa:hover { color: var(--tit); background: var(--pastel); }
  .hr-pausa .p2, .hr-pausa[aria-pressed='true'] .p1 { display: none; }
  .hr-pausa[aria-pressed='true'] .p2 { display: block; }

  /* botões no lugar da faixa de baixo do mock: linha em cima, centrados */
  .hr-b { position: relative; z-index: 3; display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; padding-block: clamp(18px, 3vh, 30px); border-top: 1px solid var(--linha); }
  .hr-b .bt { min-width: 250px; }

  @media (max-width: 900px) {
    .hr { --F: 21.4vw; min-height: auto; padding-bottom: 6px; }
    .hr-gig { top: calc(var(--barra) + 36px); scale: 1 1.36; }
    .hr-palco { position: relative; left: auto; right: auto; top: auto; bottom: auto; height: min(82vw, 380px); margin-top: calc(18vw + 28px); order: -1; }
    .hr-txt { order: 0; padding: 30px 0 22px; text-align: center; align-items: center; }
    .hr-t, .hr-p { max-width: 100%; }
    .hr-t { font-size: clamp(30px, 8.6vw, 40px); }
    .hr-p { font-size: 15px; max-width: 30ch; }
    .hr-b { flex-direction: column; align-items: stretch; border-top: 0; padding: 0 0 20px; }
    .hr-b .bt { width: 100%; min-height: 54px; }
    .hr-ctl { right: 10px; bottom: -4px; }
    .hr-f1 { left: -60px; top: 30px; width: 170px; } .hr-f2 { right: -70px; bottom: auto; top: 46%; width: 210px; }
    .hr-b1 { right: 4%; top: 36%; } .hr-b2, .hr-b4 { display: none; }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]')!;
  const slides = [...hero.querySelectorAll<HTMLElement>('[data-slide]')];
  const pts = [...hero.querySelectorAll<HTMLElement>('[data-ir]')];
  const pausa = hero.querySelector<HTMLButtonElement>('[data-pausa]')!;
  const calmo = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const DUR = 7000;
  let atual = 0, parado = calmo, segura = false, fora = false, gasto = 0, t0 = performance.now(), pronto = false;

  // ---- vídeo da cesta: MP4 com a cor em cima e a transparência embaixo; o WebGL junta as duas metades ----
  type Vid = { v: HTMLVideoElement; gl: WebGLRenderingContext; tx: WebGLTexture; ok: boolean };
  const vids = new Map<HTMLElement, Vid>();
  const celular = matchMedia('(max-width: 900px)').matches;
  const economia = (navigator as any).connection?.saveData === true;
  const av1 = (() => { try { return document.createElement('video').canPlayType('video/mp4; codecs="av01.0.08M.08"') === 'probably'; } catch { return false; } })();
  const VS = 'attribute vec2 p;varying vec2 u;void main(){u=vec2(p.x*.5+.5,.5-p.y*.5);gl_Position=vec4(p,0.,1.);}';
  const FS = 'precision mediump float;varying vec2 u;uniform sampler2D t;void main(){vec3 c=texture2D(t,vec2(u.x,u.y*.5)).rgb;float a=smoothstep(.04,.96,texture2D(t,vec2(u.x,.5+u.y*.5)).r);gl_FragColor=vec4(c*a,a);}';
  const montaGL = (cv: HTMLCanvasElement) => {
    const gl = cv.getContext('webgl', { premultipliedAlpha: true, alpha: true, antialias: false }) as WebGLRenderingContext | null;
    if (!gl) return null;
    const sh = (tipo: number, src: string) => { const s = gl.createShader(tipo)!; gl.shaderSource(s, src); gl.compileShader(s); return s; };
    const pr = gl.createProgram()!; gl.attachShader(pr, sh(gl.VERTEX_SHADER, VS)); gl.attachShader(pr, sh(gl.FRAGMENT_SHADER, FS)); gl.linkProgram(pr);
    if (!gl.getProgramParameter(pr, gl.LINK_STATUS)) return null;
    gl.useProgram(pr);
    const b = gl.createBuffer(); gl.bindBuffer(gl.ARRAY_BUFFER, b); gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
    const l = gl.getAttribLocation(pr, 'p'); gl.enableVertexAttribArray(l); gl.vertexAttribPointer(l, 2, gl.FLOAT, false, 0, 0);
    const tx = gl.createTexture()!; gl.bindTexture(gl.TEXTURE_2D, tx);
    [gl.TEXTURE_WRAP_S, gl.TEXTURE_WRAP_T].forEach((k) => gl.texParameteri(gl.TEXTURE_2D, k, gl.CLAMP_TO_EDGE));
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR); gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
    gl.clearColor(0, 0, 0, 0);
    return { gl, tx };
  };
  const pinta = (f: HTMLElement, d: Vid) => {
    const { v, gl, tx } = d;
    if (v.readyState < 2) return;
    gl.bindTexture(gl.TEXTURE_2D, tx);
    gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGB, gl.RGB, gl.UNSIGNED_BYTE, v);
    gl.clear(gl.COLOR_BUFFER_BIT); gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
    if (!d.ok) { d.ok = true; f.classList.add('vid-ok'); }
  };
  const laco = (f: HTMLElement, d: Vid) => {
    const vf = (d.v as any).requestVideoFrameCallback?.bind(d.v);
    if (vf) { const cb = () => { pinta(f, d); vf(cb); }; vf(cb); }
    else { const cb = () => { if (!d.v.paused) pinta(f, d); requestAnimationFrame(cb); }; requestAnimationFrame(cb); }
  };
  const video = (f: HTMLElement) => {
    const cv = f.querySelector<HTMLCanvasElement>('.hr-vid');
    if (!cv || vids.has(f) || calmo || economia) return false;
    const tam = (celular ? cv.dataset.p : cv.dataset.g)!.split('x').map(Number);
    cv.width = tam[0]; cv.height = tam[1];
    const g = montaGL(cv); if (!g) return false;
    const v = document.createElement('video');
    v.muted = true; v.defaultMuted = true; v.loop = true; v.playsInline = true; v.setAttribute('playsinline', ''); v.preload = 'auto';
    v.src = `/video/${cv.dataset.vid}-${celular ? 'p' : 'g'}${av1 ? '-av1' : ''}.mp4`;
    const d: Vid = { v, gl: g.gl, tx: g.tx, ok: false };
    vids.set(f, d);
    v.addEventListener('error', () => { f.classList.remove('vid-ok'); vids.delete(f); carregaQuadros(f); }, { once: true });
    laco(f, d); toca();
    return true;
  };
  // só a cesta da vez roda, e só com o topo na tela
  const toca = () => vids.forEach((d, f) => {
    const deve = f === slides[atual] && !fora && !document.hidden;
    if (deve && d.v.paused) d.v.play().catch(() => { if (!d.ok) { vids.delete(f); carregaQuadros(f); } });
    else if (!deve && !d.v.paused) d.v.pause();
  });
  document.addEventListener('visibilitychange', toca);

  // ---- reserva: os quadros da cesta virando num sprite (sem WebGL, economia de dados ou vídeo bloqueado) ----
  const carrega = (f: HTMLElement) => { if (!video(f)) carregaQuadros(f); };
  const carregaQuadros = (f: HTMLElement) => {
    const g = f.querySelector<HTMLElement>('[data-gira]')!;
    if (g.dataset.ok || calmo) return;
    g.dataset.ok = '1';
    const im = new Image(); im.decoding = 'async'; im.src = g.dataset.gira!;
    im.decode().then(() => { f.querySelectorAll<HTMLElement>('.hr-gira').forEach((x) => (x.style.backgroundImage = `url(${im.src})`)); f.classList.add('gira-ok'); }).catch(() => {});
  };
  const pos = (f: HTMLElement, i: number) => { const c = +f.dataset.cols!, r = Math.ceil(+f.dataset.n! / c); return `${((i % c) / (c - 1)) * 100}% ${(Math.floor(i / c) / Math.max(1, r - 1)) * 100}%`; };
  const quadro = (f: HTMLElement, k: number) => {
    const n = +f.dataset.n!, i = Math.max(0, Math.min(n - 1, Math.floor(k))), j = Math.min(n - 1, i + 1), fr = k - i;
    const [a, b] = f.querySelectorAll<HTMLElement>('.hr-gira');
    a.style.backgroundPosition = pos(f, i); b.style.backgroundPosition = pos(f, j); b.style.opacity = fr.toFixed(3);
  };
  // vai e volta devagar, como numa vitrine que gira; o mouse assume quando passa por cima
  let mouse = -1, mouseAte = 0;
  const vitrine = (t: number) => {
    // vai e volta sem parar (pedido do Davi: animação das cestas constante)
    const n = +slides[atual].dataset.n! - 1;
    return n / 2 - (n / 2) * Math.cos((t / 4600) * Math.PI);
  };

  const ir = (n: number) => {
    const novo = (n + slides.length) % slides.length; if (novo === atual) return;
    slides[atual].classList.remove('on'); slides[atual].classList.add('sai'); slides[atual].setAttribute('aria-hidden', 'true');
    const velho = slides[atual]; setTimeout(() => velho.classList.remove('sai'), 900);
    pts[atual].classList.remove('on'); pts[atual].style.removeProperty('--t');
    atual = novo;
    slides[atual].classList.add('on'); slides[atual].setAttribute('aria-hidden', 'false'); carrega(slides[atual]);
    pts[atual].classList.add('on'); gasto = 0; toca();
  };
  const segurar = () => { segura = true; clearTimeout((segurar as any).t); (segurar as any).t = setTimeout(() => (segura = false), 6000); };
  pts.forEach((b, i) => b.addEventListener('click', () => { ir(i); segurar(); }));
  pausa.addEventListener('click', () => { parado = !parado; pausa.setAttribute('aria-pressed', String(parado)); pausa.setAttribute('aria-label', parado ? 'Retomar a troca automática' : 'Pausar a troca automática'); });
  if (calmo) { pausa.setAttribute('aria-pressed', 'true'); pausa.setAttribute('aria-label', 'Retomar a troca automática'); }
  hero.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') { ir(atual - 1); segurar(); } if (e.key === 'ArrowRight') { ir(atual + 1); segurar(); } });
  // arrastar no celular troca a cesta
  let x0 = 0, y0 = 0;
  hero.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; }, { passive: true });
  hero.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - x0, dy = e.changedTouches[0].clientY - y0; if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy) * 1.4) { ir(atual + (dx < 0 ? 1 : -1)); segurar(); } }, { passive: true });
  const palco = hero.querySelector<HTMLElement>('[data-palco]')!;
  hero.addEventListener('focusin', () => (segura = true)); hero.addEventListener('focusout', () => (segura = false));
  new IntersectionObserver(([e]) => { fora = !e.isIntersecting; toca(); document.documentElement.classList.toggle('no-hero', e.isIntersecting); }, { threshold: 0.2 }).observe(hero);

  let k = 0;
  const tick = (t: number) => {
    if (!fora) {
      const f = slides[atual];
      if (f.classList.contains('gira-ok') && !f.classList.contains('vid-ok')) { k = vitrine(t); quadro(f, k); }
      if (pronto && !parado && !segura) { gasto += t - t0; if (gasto >= DUR) ir(atual + 1); }
      pts[atual].style.setProperty('--t', String(Math.min(1, gasto / DUR)));
    }
    t0 = t; requestAnimationFrame(tick);
  };
  const liga = () => { pronto = true; setTimeout(() => carrega(slides[0]), 300); };
  if (document.documentElement.classList.contains('abriu')) liga(); else addEventListener('mimos:abriu', liga, { once: true });
  requestAnimationFrame(tick);
</script>
