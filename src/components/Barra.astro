---
import { LOJA } from '../data/loja';
const LINKS = [['#topo', 'Início'], ['#loja', 'A loja'], ['#cardapio', 'Cardápio'], ['#cestas', 'Cestas'], ['#contato', 'Contato']];
---
<header class="br" data-barra>
  <div class="br-in">
    <a class="br-logo" href="#topo" aria-label="Mimos in Box, início">
      <img src="/img/logo-192.webp" alt="" width="96" height="96" />
    </a>
    <nav class="br-nav" aria-label="Principal">
      {LINKS.map(([h, t]) => <a href={h} class="br-l"><span data-t={t}>{t}</span></a>)}
    </nav>
    <div class="br-dir">
      <a class="br-ig" href={LOJA.instagramLink} target="_blank" rel="noopener" aria-label="Instagram da Mimos in Box">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5.5" /><circle cx="12" cy="12" r="4.2" /><circle cx="17.4" cy="6.6" r="1" fill="currentColor" stroke="none" /></svg>
      </a>
      <a class="bt bt--rosa br-cta" href="#monte">Monte a sua</a>
      <button class="br-ham" type="button" aria-expanded="false" aria-controls="menu" aria-label="Abrir menu"><i></i><i></i><i></i></button>
    </div>
  </div>
</header>

<div class="mn pt-coracoes" id="menu" aria-hidden="true">
  <nav aria-label="Menu">
    {LINKS.map(([h, t], i) => <a href={h} style={`--i:${i}`}>{t}</a>)}
    <a href="#monte" style={`--i:${LINKS.length}`}><em>Monte a sua</em></a>
  </nav>
  <div class="mn-pe">
    <a class="bt bt--claro" href={LOJA.whatsappLink} target="_blank" rel="noopener">Tirar dúvidas no WhatsApp</a>
    <a class="mn-ig" href={LOJA.instagramLink} target="_blank" rel="noopener">@{LOJA.instagram}</a>
  </div>
</div>

<style is:global>
  .br { position: fixed; inset: 0 0 auto; z-index: 60; height: var(--barra); transition: transform 0.45s var(--sai), background-color 0.3s, box-shadow 0.3s; }
  .br.some { transform: translateY(-130%); }
  .br.solida { background: var(--creme); box-shadow: 0 2px 0 var(--pastel), 0 10px 30px -18px rgba(122, 18, 48, 0.5); }
  .br-in { width: var(--larg); height: 100%; margin-inline: auto; display: flex; align-items: center; justify-content: space-between; gap: 18px; }
  .br-logo { position: relative; flex: none; width: 88px; height: 88px; margin-top: 30px; border-radius: 50%; background: var(--creme); box-shadow: 0 0 0 3px var(--creme), 0 0 0 5px var(--cereja), 0 10px 22px -10px rgba(74, 19, 34, 0.7); transition: transform 0.5s var(--mola), width 0.3s, height 0.3s, margin 0.3s; }
  .br-logo img { width: 100%; height: 100%; border-radius: 50%; }
  .br-logo:hover { transform: rotate(-8deg) scale(1.06); }
  .br.solida .br-logo { width: 62px; height: 62px; margin-top: 14px; }
  .br-nav { display: flex; gap: clamp(14px, 2.2vw, 30px); }
  .br-l { position: relative; display: block; overflow: hidden; height: 1.5em; font-weight: 800; font-size: 16px; color: var(--cereja); text-decoration: none; }
  .br-l span { display: block; transition: transform 0.4s var(--sai); }
  .br-l span::after { content: attr(data-t); display: block; color: var(--framboesa); }
  .br-l:hover span { transform: translateY(-50%); }
  .br-dir { display: flex; align-items: center; gap: 12px; }
  .br-ig { width: 44px; height: 44px; display: grid; place-items: center; color: var(--cereja); border-radius: 50%; transition: transform 0.4s var(--mola), background-color 0.2s; }
  .br-ig:hover { transform: rotate(12deg) scale(1.1); background: var(--pastel); }
  .br-cta { min-height: 44px; padding: 0 20px; font-size: 15px; box-shadow: 0 4px 0 var(--bd); }
  .br-ham { display: none; position: relative; width: 48px; height: 48px; border: 2px solid var(--cereja); border-radius: 50%; background: var(--creme); box-shadow: 0 3px 0 var(--cereja); z-index: 80; }
  .br-ham i { position: absolute; left: 12px; right: 12px; height: 2.5px; border-radius: 2px; background: var(--cereja); transition: transform 0.4s var(--mola), opacity 0.2s, top 0.3s; }
  .br-ham i:nth-child(1) { top: 15px; } .br-ham i:nth-child(2) { top: 21px; } .br-ham i:nth-child(3) { top: 27px; }
  .br-ham[aria-expanded='true'] i:nth-child(1) { top: 21px; transform: rotate(45deg); }
  .br-ham[aria-expanded='true'] i:nth-child(2) { opacity: 0; }
  .br-ham[aria-expanded='true'] i:nth-child(3) { top: 21px; transform: rotate(-45deg); }

  /* menu que nasce do botão */
  .mn { position: fixed; inset: 0; z-index: 55; background-color: var(--cereja); color: var(--creme); display: flex; flex-direction: column; justify-content: space-between; padding: 110px 28px 34px; visibility: hidden; clip-path: circle(0 at calc(100% - 44px) 34px); transition: clip-path 0.6s var(--sai), visibility 0s 0.6s; max-height: 100dvh; overflow-y: auto; }
  .mn.on { visibility: visible; clip-path: circle(150% at calc(100% - 44px) 34px); transition: clip-path 0.7s var(--sai), visibility 0s; }
  .mn nav { display: grid; gap: 4px; }
  .mn nav a { font-family: var(--f-script); font-size: clamp(38px, 11vw, 54px); line-height: 1.15; text-decoration: none; opacity: 0; transform: translateY(26px) rotate(3deg); transition: opacity 0.4s, transform 0.6s var(--mola); }
  .mn nav a em { font-style: normal; color: var(--pastel); }
  .mn.on nav a { opacity: 1; transform: none; transition-delay: calc(0.18s + var(--i) * 60ms); }
  .mn-pe { display: grid; gap: 14px; justify-items: start; }
  .mn-ig { font-weight: 800; color: var(--pastel); }

  @media (max-width: 900px) {
    .br-nav, .br-cta, .br-ig { display: none; }
    .br-ham { display: block; }
    .br-logo { width: 74px; height: 74px; margin-top: 22px; }
    .br.solida .br-logo { width: 54px; height: 54px; margin-top: 8px; }
  }
  @media (min-width: 901px) { .mn { display: none; } }
</style>

<script>
  const barra = document.querySelector<HTMLElement>('[data-barra]')!;
  const ham = barra.querySelector<HTMLButtonElement>('.br-ham')!;
  const menu = document.getElementById('menu')!;
  let ult = 0, tic = false;
  const aoRolar = () => {
    const y = scrollY;
    barra.classList.toggle('solida', y > 40);
    if (!menu.classList.contains('on')) { if (y > 420 && y > ult + 4) barra.classList.add('some'); else if (y < ult - 4 || y <= 420) barra.classList.remove('some'); }
    ult = y; tic = false;
  };
  addEventListener('scroll', () => { if (!tic) { tic = true; requestAnimationFrame(aoRolar); } }, { passive: true });
  aoRolar();
  const abre = (on: boolean) => {
    menu.classList.toggle('on', on); menu.setAttribute('aria-hidden', String(!on));
    ham.setAttribute('aria-expanded', String(on)); ham.setAttribute('aria-label', on ? 'Fechar menu' : 'Abrir menu');
    document.documentElement.style.overflow = on ? 'hidden' : '';
    if (on) barra.classList.remove('some');
  };
  ham.addEventListener('click', () => abre(!menu.classList.contains('on')));
  menu.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) abre(false); });
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && menu.classList.contains('on')) { abre(false); ham.focus(); } });
</script>
