---
// Duas fitas cruzadas (como o laço do presente), com letreiro andando em sentidos opostos. Pausa no hover e no foco.
import { CORACAO } from '../data/arte';
const A = ['cestas de café da manhã', 'kits presente', 'bebê e infantil', 'monte a sua cesta', 'feito com carinho'];
const B = ['aniversário', 'maternidade', 'namorados', 'dia das mães', 'agradecimento', 'chá de bebê'];
interface Props { inverso?: boolean }
const { inverso = false } = Astro.props;
---
<div class:list={['fx', inverso && 'fx--inv']} aria-hidden="true">
  {[A, B].map((lista, k) => (
    <div class:list={['fx-f', `fx-f${k}`]}>
      <div class="fx-t">
        {[0, 1].map(() => lista.concat(lista).map((t) => (
          <span>{t}<svg viewBox="0 0 24 24" width="18" height="18"><path d={CORACAO} fill="currentColor" /></svg></span>
        )))}
      </div>
    </div>
  ))}
</div>

<style is:global>
  /* fitas de gorgorão: fio dourado nas bordas, letreiro em caixa alta espaçada */
  .fx { position: relative; height: 140px; margin-block: -48px; z-index: 5; pointer-events: none; }
  .fx-f { position: absolute; left: -6vw; right: -6vw; top: 50%; height: 50px; margin-top: -25px; display: flex; align-items: center; overflow: hidden; pointer-events: auto; box-shadow: 0 10px 22px -12px rgba(40, 0, 14, 0.6); }
  .fx-f::before { content: ''; position: absolute; inset: 5px 0; border-block: 1px solid var(--fio); pointer-events: none; }
  .fx-f0 { --fio: rgba(216, 189, 140, 0.6); background: linear-gradient(180deg, rgba(251, 246, 240, 0.1), transparent 34%, transparent 66%, rgba(20, 0, 8, 0.22)), var(--cereja); color: var(--creme); rotate: -2.2deg; z-index: 2; }
  .fx-f1 { --fio: rgba(164, 124, 60, 0.45); background: linear-gradient(180deg, rgba(251, 246, 240, 0.5), transparent 40%, transparent 70%, rgba(106, 16, 41, 0.08)), var(--pastel); color: var(--cereja); rotate: 1.8deg; }
  .fx--inv .fx-f0 { rotate: 2.2deg; } .fx--inv .fx-f1 { rotate: -1.8deg; }
  .fx-t { display: flex; flex: none; width: max-content; animation: fx-anda 60s linear infinite; }
  .fx-f1 .fx-t { animation-direction: reverse; animation-duration: 74s; }
  .fx-f:hover .fx-t { animation-play-state: paused; }
  .fx-t span { display: inline-flex; align-items: center; gap: 24px; margin-right: 24px; font-weight: 800; font-size: 13px; letter-spacing: 0.2em; text-transform: uppercase; white-space: nowrap; }
  .fx-t svg { width: 11px; height: 11px; color: var(--ouro-cl); }
  .fx-f1 .fx-t svg { color: var(--rosa); }
  @keyframes fx-anda { to { transform: translateX(-50%); } }
  @media (max-width: 700px) { .fx { height: 116px; margin-block: -38px; } .fx-f { height: 44px; margin-top: -22px; } .fx-f::before { inset: 4px 0; } .fx-t span { font-size: 11.5px; gap: 16px; margin-right: 16px; } }
</style>
