---
// Duas fitas cruzadas (como o laço do presente), com letreiro andando em sentidos opostos. Pausa no hover e no foco.
import { CORACAO } from '../data/arte';
const A = ['cestas de café da manhã', 'kits presente', 'bebê e infantil', 'monte a sua cesta', 'feito com carinho'];
const B = ['aniversário', 'maternidade', 'namorados', 'dia das mães', 'agradecimento', 'chá de bebê'];
interface Props { inverso?: boolean }
const { inverso = false } = Astro.props;
---
<div class:list={['fx', inverso && 'fx--inv']} aria-hidden="true">
  {[A, B].map((lista, k) => (
    <div class:list={['fx-f', `fx-f${k}`]}>
      <div class="fx-t">
        {[0, 1].map(() => lista.concat(lista).map((t) => (
          <span>{t}<svg viewBox="0 0 24 24" width="18" height="18"><path d={CORACAO} fill="currentColor" /></svg></span>
        )))}
      </div>
    </div>
  ))}
</div>

<style is:global>
  .fx { position: relative; height: 150px; margin-block: -52px; z-index: 5; pointer-events: none; }
  .fx-f { position: absolute; left: -6vw; right: -6vw; top: 50%; height: 56px; margin-top: -28px; display: flex; align-items: center; overflow: hidden; pointer-events: auto; box-shadow: 0 8px 20px -10px rgba(60, 0, 20, 0.55); }
  .fx-f0 { background: var(--cereja); color: var(--creme); rotate: -2.4deg; z-index: 2; border-block: 3px solid var(--cereja-esc); }
  .fx-f1 { background: var(--pastel); color: var(--cereja); rotate: 2deg; border-block: 3px solid var(--rosa-cl); }
  .fx--inv .fx-f0 { rotate: 2.4deg; } .fx--inv .fx-f1 { rotate: -2deg; }
  .fx-t { display: flex; flex: none; width: max-content; animation: fx-anda 46s linear infinite; }
  .fx-f1 .fx-t { animation-direction: reverse; animation-duration: 58s; }
  .fx-f:hover .fx-t { animation-play-state: paused; }
  .fx-t span { display: inline-flex; align-items: center; gap: 26px; margin-right: 26px; font-family: var(--f-gorda); font-size: 21px; white-space: nowrap; }
  .fx-t svg { color: var(--rosa-cl); }
  .fx-f1 .fx-t svg { color: var(--framboesa); }
  .fx-f0::after { content: ''; position: absolute; inset: 0; background: linear-gradient(100deg, transparent 40%, rgba(255, 255, 255, 0.22) 50%, transparent 60%); background-size: 300% 100%; animation: fx-brilho 7s linear infinite; }
  @keyframes fx-anda { to { transform: translateX(-50%); } }
  @keyframes fx-brilho { from { background-position: 150% 0; } to { background-position: -150% 0; } }
  @media (max-width: 700px) { .fx { height: 120px; margin-block: -40px; } .fx-f { height: 46px; margin-top: -23px; } .fx-t span { font-size: 17px; gap: 18px; margin-right: 18px; } }
</style>
